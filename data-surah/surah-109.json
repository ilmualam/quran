        "rumi": "Wa laa ana 'abidum maa 'abattum",
        "translation": "\"Dan aku tidak akan beribadat secara kamu beribadat.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6211.mp3"
    },
    {
        "id": 5,
