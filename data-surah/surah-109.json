    },
    {
        "id": 2,
        "arabic": "لَآ أَعْبُدُ مَا تَعْبُدُونَ",
        "jawi": "",
        "rumi": "Laa a'budu ma t'abudoon",
        "translation": "\"Aku tidak akan menyembah apa yang kamu sembah.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6209.mp3"
    },
    {
        "id": 3,
        "arabic": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ",
        "jawi": "",
        "rumi": "Wa laa antum 'aabidoona maa a'bud",
        "translation": "\"Dan kamu tidak mahu menyembah (Allah) yang aku sembah.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6210.mp3"
    },
    {
        "id": 4,
        "arabic": "وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ",
