[
    {
        "id": 1,
        "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ",
        "jawi": "",
        "rumi": "'Abasa wa tawallaa.",
        "translation": "Ia memasamkan muka dan berpaling,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5759.mp3"
    },
    {
        "id": 2,
        "arabic": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
        "jawi": "",
        "rumi": "An jaa-ahul 'a-maa",
        "translation": "Kerana ia didatangi orang buta.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5760.mp3"
    },
    {
        "id": 3,
        "arabic": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
        "jawi": "",
        "rumi": "Wa maa yudreeka la'allahu yaz zakkaa.",
        "translation": "Dan apa jalannya engkau dapat mengetahui (tujuannya, wahai Muhammad) ? Barangkali ia mahu membersihkan hatinya (dengan pelajaran ugama yang didapatinya daripadamu)! -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5761.mp3"
    },
    {
        "id": 4,
        "arabic": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
        "jawi": "",
        "rumi": "Au yaz zak karu fatanfa 'ahuz zikraa.",
        "translation": "Ataupun ia mahu mendapat peringatan, supaya peringatan itu memberi manfaat kepadanya.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5762.mp3"
    },
    {
        "id": 5,
        "arabic": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
        "jawi": "",
        "rumi": "Amma manis taghnaa",
        "translation": "Adapun orang yang merasa keadaannya telah cukup, tidak berhajat lagi (kepada ajaran Al-Quran),",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5763.mp3"
    },
    {
        "id": 6,
        "arabic": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
        "jawi": "",
        "rumi": "Fa-anta lahu tasaddaa",
        "translation": "Maka engkau bersungguh-sungguh melayaninya.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5764.mp3"
    },
    {
        "id": 7,
        "arabic": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
        "jawi": "",
        "rumi": "Wa ma 'alaika allaa yaz zakka.",
        "translation": "Padahal engkau tidak bersalah kalau ia tidak mahu membersihkan dirinya (dari keingkarannya).",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5765.mp3"
    },
    {
        "id": 8,
        "arabic": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
        "jawi": "",
        "rumi": "Wa amma man jaa-aka yas'a",
        "translation": "Adapun orang yang segera datang kepadamu,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5766.mp3"
    },
    {
        "id": 9,
        "arabic": "وَهُوَ يَخْشَىٰ",
        "jawi": "",
        "rumi": "Wahuwa yakhshaa,",
        "translation": "Dengan perasaan takutnya (melanggar perintah-perintah Allah), -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5767.mp3"
    },
    {
        "id": 10,
        "arabic": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
        "jawi": "",
        "rumi": "Fa-anta 'anhu talah haa.",
        "translation": "Maka engkau berlengah-lengah melayaninya.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5768.mp3"
    },
    {
        "id": 11,
        "arabic": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ",
        "jawi": "",
        "rumi": "Kalla innaha tazkirah",
        "translation": "Janganlah melakukan lagi yang sedemikian itu! Sebenarnya ayat-ayat Al-Quran adalah pengajaran dan peringatan (yang mencukupi).",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5769.mp3"
    },
    {
        "id": 12,
        "arabic": "فَمَن شَآءَ ذَكَرَهُۥ",
        "jawi": "",
        "rumi": "Faman shaa a zakarah",
        "translation": "Maka sesiapa yang mahukan kebaikan dirinya, dapatlah ia mengambil peringatan daripadanya.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5770.mp3"
    },
    {
        "id": 13,
        "arabic": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ",
        "jawi": "",
        "rumi": "Fi suhufim mukar rama,",
        "translation": "(Ayat-ayat Suci itu tersimpan) dalam naskhah-naskhah yang dimuliakan, -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5771.mp3"
    },
    {
        "id": 14,
        "arabic": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ",
        "jawi": "",
        "rumi": "Marfoo'atim mutah hara,",
        "translation": "Yang tinggi darjatnya, lagi suci (dari segala gangguan), -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5772.mp3"
    },
    {
        "id": 15,
        "arabic": "بِأَيْدِى سَفَرَةٍۢ",
        "jawi": "",
        "rumi": "Bi'aidee safara",
        "translation": "(Terpelihara) di tangan malaikat-malaikat yang menyalinnya dari Lauh Mahfuz;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5773.mp3"
    },
    {
        "id": 16,
        "arabic": "كِرَامٍۭ بَرَرَةٍۢ",
        "jawi": "",
        "rumi": "Kiraamim bararah.",
        "translation": "(Malaikat-malaikat) yang mulia, lagi yang berbakti.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5774.mp3"
    },
    {
        "id": 17,
        "arabic": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ",
        "jawi": "",
        "rumi": "Qutilal-insanu maa akfarah.",
        "translation": "Binasalah hendaknya manusia (yang ingkar) itu, betapa besar kekufurannya?",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5775.mp3"
    },
    {
        "id": 18,
        "arabic": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
        "jawi": "",
        "rumi": "Min aiyyi shai-in Khalaq",
        "translation": "(Tidakkah ia memikirkan) dari apakah ia diciptakan oleh Allah? -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5776.mp3"
    },
    {
        "id": 19,
        "arabic": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
        "jawi": "",
        "rumi": "Min nutfah; khalaqahu faqad-darah.",
        "translation": "Dari air mani diciptakanNya, serta dilengkapkan keadaannya dengan persediaan untuk bertanggungjawab;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5777.mp3"
    },
    {
        "id": 20,
        "arabic": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
        "jawi": "",
        "rumi": "Thummas sabeela yas-sarah",
        "translation": "Kemudian jalan (baik dan jahat), dimudahkan Tuhan kepadanya (untuk menimbang dan mengambil mana satu yang ia pilih);",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5778.mp3"
    },
    {
        "id": 21,
        "arabic": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
        "jawi": "",
        "rumi": "Thumma amatahu fa-aqbarah",
        "translation": "Kemudian dimatikannya, lalu diperintahkan supaya ia dikuburkan;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5779.mp3"
    },
    {
        "id": 22,
        "arabic": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
        "jawi": "",
        "rumi": "Thumma iza shaa-a ansharah",
        "translation": "Kemudian apabila Allah kehendaki dibangkitkannya (hidup semula).",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5780.mp3"
    },
    {
        "id": 23,
        "arabic": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
        "jawi": "",
        "rumi": "Kalla lamma yaqdi maa amarah.",
        "translation": "Janganlah hendaknya ia kufur ingkar lagi! Sebenarnya ia belum menunaikan apa yang diperintahkan kepadanya.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5781.mp3"
    },
    {
        "id": 24,
        "arabic": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
        "jawi": "",
        "rumi": "Falyanzuril insanu ilaa ta-amih",
        "translation": "(Kalaulah ia tidak memikirkan asal dan kesudahan dirinya), maka hendaklah manusia melihat kepada makanannya (bagaimana kami mentadbirkannya):",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5782.mp3"
    },
    {
        "id": 25,
        "arabic": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا",
        "jawi": "",
        "rumi": "Anna sabab nalmaa-a sabba.",
        "translation": "Sesungguhnya kami telah mencurahkan hujan dengan curahan yang menakjubkan.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5783.mp3"
    },
    {
        "id": 26,
        "arabic": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا",
        "jawi": "",
        "rumi": "Thumma sha qaqnal-arda shaqqa.",
        "translation": "Kemudian kami belah-belahkan bumi dengan belahan yang sesuai dengan tumbuh-tumbuhan, -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5784.mp3"
    },
    {
        "id": 27,
        "arabic": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا",
        "jawi": "",
        "rumi": "Fa ambatna feeha habba",
        "translation": "Lalu Kami tumbuhkan pada bumi biji-bijian,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5785.mp3"
    },
    {
        "id": 28,
        "arabic": "وَعِنَبًۭا وَقَضْبًۭا",
        "jawi": "",
        "rumi": "Wa 'inabaw-wa qadba",
        "translation": "Dan buah anggur serta sayur-sayuran,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5786.mp3"
    },
    {
        "id": 29,
        "arabic": "وَزَيْتُونًۭا وَنَخْلًۭا",
        "jawi": "",
        "rumi": "Wa zaitoonaw wanakh la'",
        "translation": "Dan Zaitun serta pohon-pohon kurma,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5787.mp3"
    },
    {
        "id": 30,
        "arabic": "وَحَدَآئِقَ غُلْبًۭا",
        "jawi": "",
        "rumi": "Wa hadaa-iqa ghulba",
        "translation": "Dan taman-taman yang menghijau subur,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5788.mp3"
    },
    {
        "id": 31,
        "arabic": "وَفَٰكِهَةًۭ وَأَبًّۭا",
        "jawi": "",
        "rumi": "Wa faki hataw-wa abba.",
        "translation": "Dan berbagai buah-buahan serta bermacam-macam rumput, -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5789.mp3"
    },
    {
        "id": 32,
        "arabic": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
        "jawi": "",
        "rumi": "Mata'al-lakum wa li-an'amikum.",
        "translation": "Untuk kegunaan kamu dan binatang-binatang ternak kamu.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5790.mp3"
    },
    {
        "id": 33,
        "arabic": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
        "jawi": "",
        "rumi": "Faiza jaa-atis saakhah.",
        "translation": "Kemudian (ingatlah keadaan yang berlaku) apabila datang suara jeritan yang dahsyat, -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5791.mp3"
    },
    {
        "id": 34,
        "arabic": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
        "jawi": "",
        "rumi": "Yauma yafir-rul mar-u min akheeh",
        "translation": "Pada hari seseorang itu lari dari saudaranya,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5792.mp3"
    },
    {
        "id": 35,
        "arabic": "وَأُمِّهِۦ وَأَبِيهِ",
        "jawi": "",
        "rumi": "Wa ummihee wa abeeh",
        "translation": "Dan ibunya serta bapanya,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5793.mp3"
    },
    {
        "id": 36,
        "arabic": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
        "jawi": "",
        "rumi": "Wa sahi batihee wa baneeh.",
        "translation": "Dan isterinya serta anak-anaknya; -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5794.mp3"
    },
    {
        "id": 37,
        "arabic": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ",
        "jawi": "",
        "rumi": "Likul limri-im-minuhm yaumaa-izin shaa nuy-yughneeh",
        "translation": "Kerana tiap-tiap seorang dari mereka pada hari itu, ada perkara-perkara yang cukup untuk menjadikannya sibuk dengan hal dirinya sahaja.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5795.mp3"
    },
    {
        "id": 38,
        "arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ",
        "jawi": "",
        "rumi": "Wujoo huny-yauma-izim-musfira;",
        "translation": "Muka (orang-orang yang beriman) pada hari itu berseri-seri,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5796.mp3"
    },
    {
        "id": 39,
        "arabic": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ",
        "jawi": "",
        "rumi": "Dahi katum mustab shirah",
        "translation": "Tertawa, lagi bersuka ria;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5797.mp3"
    },
    {
        "id": 40,
        "arabic": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ",
        "jawi": "",
        "rumi": "Wa wujoohuy yauma-izin 'alaiha ghabar a",
        "translation": "Dan muka (orang-orang yang ingkar) pada hari itu penuh berdebu,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5798.mp3"
    },
    {
        "id": 41,
        "arabic": "تَرْهَقُهَا قَتَرَةٌ",
        "jawi": "",
        "rumi": "Tarhaquha qatarah.",
        "translation": "Diliputi oleh warna hitam legam dan gelap-gelita. -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5799.mp3"
    },
    {
        "id": 42,
        "arabic": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
        "jawi": "",
        "rumi": "Ulaa-ika humul-kafa ratul-fajarah.",
        "translation": "Mereka itu ialah orang-orang yang kafir, yang derhaka.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5800.mp3"
    }
]