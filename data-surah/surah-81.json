[
    {
        "id": 1,
        "arabic": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
        "jawi": "",
        "rumi": "Izash shamsu kuwwirat",
        "translation": "Apabila matahari dilingkari cahayanya (dan hilang lenyap);",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5801.mp3"
    },
    {
        "id": 2,
        "arabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
        "jawi": "",
        "rumi": "Wa izan nujoomun kadarat",
        "translation": "Dan apabila bintang-bintang gugur berselerak;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5802.mp3"
    },
    {
        "id": 3,
        "arabic": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
        "jawi": "",
        "rumi": "Wa izal jibaalu suyyirat",
        "translation": "Dan apabila gunung-ganang di terbangkan ke angkasa (setelah dihancurkan menjadi debu);",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5803.mp3"
    },
    {
        "id": 4,
        "arabic": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
        "jawi": "",
        "rumi": "Wa izal 'ishaaru 'uttilat",
        "translation": "Dan apabila unta-unta yang bunting terbiar;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5804.mp3"
    },
    {
        "id": 5,
        "arabic": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
        "jawi": "",
        "rumi": "Wa izal wuhooshu hushirat",
        "translation": "Dan apabila binatang-binatang liar dihimpunkan;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5805.mp3"
    },
    {
        "id": 6,
        "arabic": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
        "jawi": "",
        "rumi": "Wa izal bihaaru sujjirat",
        "translation": "Dan apabila lautan meluap-luap bercampur-baur;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5806.mp3"
    },
    {
        "id": 7,
        "arabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
        "jawi": "",
        "rumi": "Wa izan nufoosu zuwwijat",
        "translation": "Dan apabila tiap-tiap diri disatukan dengan pasangannya;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5807.mp3"
    },
    {
        "id": 8,
        "arabic": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
        "jawi": "",
        "rumi": "Wa izal maw'oodatu su'ilat",
        "translation": "Dan apabila anak perempuan yang ditanam hidup-hidup: ditanya, -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5808.mp3"
    },
    {
        "id": 9,
        "arabic": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ",
        "jawi": "",
        "rumi": "Bi ayyi zambin qutilat",
        "translation": "Dengan dosa apakah ia dibunuh?",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5809.mp3"
    },
    {
        "id": 10,
        "arabic": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
        "jawi": "",
        "rumi": "Wa izas suhufu nushirat",
        "translation": "Dan apabila surat-surat amal dibentangkan;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5810.mp3"
    },
    {
        "id": 11,
        "arabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
        "jawi": "",
        "rumi": "Wa izas samaaa'u kushitat",
        "translation": "Dan apabila langit ditanggalkan dari tempatnya;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5811.mp3"
    },
    {
        "id": 12,
        "arabic": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
        "jawi": "",
        "rumi": "Wa izal jaheemu su'-'irat",
        "translation": "Dan apabila neraka dinyalakan menjulang;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5812.mp3"
    },
    {
        "id": 13,
        "arabic": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
        "jawi": "",
        "rumi": "Wa izal jannatu uzlifat",
        "translation": "Dan apabila Syurga didekatkan;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5813.mp3"
    },
    {
        "id": 14,
        "arabic": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ",
        "jawi": "",
        "rumi": "'Alimat nafsum maaa ahdarat",
        "translation": "(Setelah semuanya itu berlaku), tiap-tiap orang akan mengetahui tentang amal yang telah dibawanya.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5814.mp3"
    },
    {
        "id": 15,
        "arabic": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
        "jawi": "",
        "rumi": "Falaaa uqsimu bil khunnas",
        "translation": "Oleh itu, Aku bersumpah dengan bintang-bintang yang tenggelam timbul;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5815.mp3"
    },
    {
        "id": 16,
        "arabic": "ٱلْجَوَارِ ٱلْكُنَّسِ",
        "jawi": "",
        "rumi": "Al jawaaril kunnas",
        "translation": "Yang beredar, juga yang tetap pada tempatnya;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5816.mp3"
    },
    {
        "id": 17,
        "arabic": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
        "jawi": "",
        "rumi": "Wallaili izaa 'as'as",
        "translation": "Dan malam, apabila ia hampir habis,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5817.mp3"
    },
    {
        "id": 18,
        "arabic": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
        "jawi": "",
        "rumi": "Wassubhi izaa tanaffas",
        "translation": "Dan siang, apabila ia mulai terang;",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5818.mp3"
    },
    {
        "id": 19,
        "arabic": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ",
        "jawi": "",
        "rumi": "Innahoo laqawlu rasoolin kareem",
        "translation": "Sebenarnya Al-Quran itu, sungguh-sungguh Kalamullah (yang disampaikan oleh Jibril) Utusan yang mulia,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5819.mp3"
    },
    {
        "id": 20,
        "arabic": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ",
        "jawi": "",
        "rumi": "Zee quwwatin 'inda zil 'arshi makeen",
        "translation": "Yang kuat gagah, lagi berkedudukan tinggi di sisi Allah yang mempunyai Arasy,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5820.mp3"
    },
    {
        "id": 21,
        "arabic": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ",
        "jawi": "",
        "rumi": "Mutaa'in samma ameen",
        "translation": "Yang ditaati di sana (dalam kalangan malaikat), lagi dipercayai.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5821.mp3"
    },
    {
        "id": 22,
        "arabic": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ",
        "jawi": "",
        "rumi": "Wa maa saahibukum bimajnoon",
        "translation": "Dan sebenarnya sahabat kamu (Nabi Muhammad) itu (wahai golongan yang menentang Islam), bukanlah ia seorang gila (seperti yang kamu tuduh);",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5822.mp3"
    },
    {
        "id": 23,
        "arabic": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
        "jawi": "",
        "rumi": "Wa laqad ra aahu bilufuqil mubeen",
        "translation": "Dan (Nabi Muhammad yakin bahawa yang disampaikan kepadanya ialah wahyu dari Tuhan, kerana) demi sesungguhnya! Nabi Muhammad telah mengenal dan melihat Jibril di kaki langit yang nyata.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5823.mp3"
    },
    {
        "id": 24,
        "arabic": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ",
        "jawi": "",
        "rumi": "Wa maa huwa 'alal ghaibi bidaneen",
        "translation": "Dan bukanlah Nabi Muhammad seorang yang boleh dituduh dan disangka buruk, terhadap penyampaiannya mengenai perkara-perkara yang ghaib.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5824.mp3"
    },
    {
        "id": 25,
        "arabic": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ",
        "jawi": "",
        "rumi": "Wa maa huwa biqawli shaitaanir rajeem",
        "translation": "Dan sebenarnya Al-Quran itu bukanlah perkataan Syaitan yang kena rejam.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5825.mp3"
    },
    {
        "id": 26,
        "arabic": "فَأَيْنَ تَذْهَبُونَ",
        "jawi": "",
        "rumi": "Fa ayna tazhaboon",
        "translation": "(Dengan yang demikian) maka ke manakah kamu hendak pergi (kiranya kamu masih menyeleweng dari jalan Al-Quran)?",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5826.mp3"
    },
    {
        "id": 27,
        "arabic": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ",
        "jawi": "",
        "rumi": "In huwa illaa zikrul lil'aalameen",
        "translation": "Al-Quran itu tidak lain hanyalah peringatan bagi seluruh penduduk alam:",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5827.mp3"
    },
    {
        "id": 28,
        "arabic": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
        "jawi": "",
        "rumi": "Liman shaaa'a minkum ai yastaqeem",
        "translation": "Iaitu bagi sesiapa dari kamu yang mahu tetap teguh di atas jalan (Islam) yang betul.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5828.mp3"
    },
    {
        "id": 29,
        "arabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ",
        "jawi": "",
        "rumi": "Wa maa tashaaa'oona illaaa ai yashaaa 'al laahu Rabbul 'Aalameen",
        "translation": "Dan kamu tidak dapat menentukan kemahuan kamu (mengenai sesuatupun), kecuali dengan cara yang diatur oleh Allah, Tuhan yang memelihara dan mentadbirkan seluruh alam.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5829.mp3"
    }
]