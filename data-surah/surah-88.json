[
    {
        "id": 1,
        "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ",
        "jawi": "",
        "rumi": "Hal ataaka hadeesul ghaashiyah",
        "translation": "Sudahkah sampai kepadamu (wahai Muhammad) perihal hari kiamat yang huru-haranya meliputi?",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5968.mp3"
    },
    {
        "id": 2,
        "arabic": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ",
        "jawi": "",
        "rumi": "Wujoohuny yawma 'izin khaashi'ah",
        "translation": "Muka (orang-orang yang kafir) pada hari itu tunduk kerana merasa hina,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5969.mp3"
    },
    {
        "id": 3,
        "arabic": "عَامِلَةٌۭ نَّاصِبَةٌۭ",
        "jawi": "",
        "rumi": "'Aamilatun naasibah",
        "translation": "Mereka menjalankan kerja yang berat lagi berpenat lelah,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5970.mp3"
    },
    {
        "id": 4,
        "arabic": "تَصْلَىٰ نَارًا حَامِيَةًۭ",
        "jawi": "",
        "rumi": "Taslaa naaran haamiyah",
