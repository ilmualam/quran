    },
    {
        "id": 16,
        "arabic": "وَزَرَابِىُّ مَبْثُوثَةٌ",
        "jawi": "",
        "rumi": "Wa zaraabiyyu mabsoosah",
        "translation": "Serta hamparan-hamparan yang terbentang.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5983.mp3"
    },
    {
        "id": 17,
        "arabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
        "jawi": "",
        "rumi": "Afalaa yanzuroona ilalibili kaifa khuliqat",
        "translation": "(Mengapa mereka yang kafir masih mengingkari akhirat) tidakkah mereka memperhatikan keadaan unta bagaimana ia diciptakan?",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5984.mp3"
    },
    {
        "id": 18,
