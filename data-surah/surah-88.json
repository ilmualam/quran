    },
    {
        "id": 8,
        "arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ",
        "jawi": "",
        "rumi": "Wujoohuny yawma 'izin naa'imah",
        "translation": "(Sebaliknya) muka (orang-orang yang beriman) pada hari itu berseri-seri,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5975.mp3"
    },
    {
        "id": 9,
        "arabic": "لِّسَعْيِهَا رَاضِيَةٌۭ",
        "jawi": "",
        "rumi": "Lisa'yihaa raadiyah",
        "translation": "Berpuas hati dengan balasan amal usahanya (yang baik yang telah dikerjakannya di dunia), -",
