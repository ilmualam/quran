        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5971.mp3"
    },
    {
        "id": 5,
        "arabic": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ",
        "jawi": "",
        "rumi": "Tusqaa min 'aynin aaniyah",
        "translation": "Mereka diberi minum dari matair yang menggelegak panasnya.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5972.mp3"
    },
    {
        "id": 6,
        "arabic": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ",
        "jawi": "",
        "rumi": "Laisa lahum ta'aamun illaa min daree'",
        "translation": "Tiada makanan bagi mereka (di situ) selain dari pokok-pokok yang berduri,",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5973.mp3"
    },
    {
        "id": 7,
        "arabic": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ",
        "jawi": "",
        "rumi": "Laa yusminu wa laa yughnee min joo'",
        "translation": "Yang tidak menggemokkan, dan tidak pula dapat menghilangkan sedikit kelaparan pun.",
