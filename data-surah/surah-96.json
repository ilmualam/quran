        "jawi": "",
        "rumi": "Nasiyatin kazi batin khaatiyah",
        "translation": "Ubun-ubun (orang) yang berdusta, yang bersalah.",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6122.mp3"
    },
    {
        "id": 17,
        "arabic": "فَلْيَدْعُ نَادِيَهُۥ",
        "jawi": "",
        "rumi": "Fal yad'u naadiyah",
        "translation": "Kemudian biarlah ia memanggil kumpulannya (untuk menyelamatkannya),",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6123.mp3"
    },
    {
        "id": 18,
        "arabic": "سَنَدْعُ ٱلزَّبَانِيَةَ",
        "jawi": "",
        "rumi": "Sanad 'uz zabaaniyah",
