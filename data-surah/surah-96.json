    },
    {
        "id": 8,
        "arabic": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
        "jawi": "",
        "rumi": "Innna ilaa rabbikar ruj'aa",
        "translation": "(Ingatlah) sesungguhnya kepada Tuhanmu lah tempat kembali (untuk menerima balasan).",
