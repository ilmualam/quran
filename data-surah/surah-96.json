    },
    {
        "id": 19,
        "arabic": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
        "jawi": "",
        "rumi": "Kalla; la tuti'hu wasjud waqtarib",
        "translation": "Ingatlah! Janganlah engkau (wahai Muhammad) menurut kehendaknya, dan (sebaliknya) sujudlah dan dampingkanlah dirimu kepada Allah (dengan taat dan beramal soleh)!",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6125.mp3"
