    },
    {
        "id": 14,
        "arabic": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
        "jawi": "",
        "rumi": "Alam y'alam bi-an nal lahaa yaraa",
        "translation": "Tidakkah ia mengetahui bahawa sesungguhnya Allah melihat (segala amal perbuatannya dan membalasnya)?",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6120.mp3"
    },
    {
        "id": 15,
        "arabic": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
        "jawi": "",
        "rumi": "Kalla la illam yantahi la nasfa'am bin nasiyah",
        "translation": "Jangan sekali-kali berlaku derhaka! Demi sesungguhnya jika ia tidak berhenti (dari perbuatannya yang buruk itu), nescaya Kami akan menyentap ubun-ubunnya (dan menyeretnya ke dalam neraka), -",
        "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6121.mp3"
    },
    {
        "id": 16,
