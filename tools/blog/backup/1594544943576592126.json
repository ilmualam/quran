nd:linear-gradient(135deg, #f1f8e9 0%, #dcedc8 100%); border:3px solid #4a7c2c; padding:20px; margin:24px 0; border-radius:12px; font-size:15px;}\n.ilmx-kedah-rice-box strong {color:#2d5016;}\n.ilmx-kedah-cta {background:linear-gradient(135deg, #f1f8e9 0%, #dcedc8 100%); border:3px dashed #4a7c2c; padding:24px; margin:28px 0; border-radius:16px; text-align:center;}\n.ilmx-kedah-cta p {margin-bottom:14px; color:#2d5016; font-weight:600; font-size:16px;}\n.ilmx-kedah-btn {display:inline-block; background:linear-gradient(135deg, #2d5016 0%, #4a7c2c 100%); color:#fff; padding:14px 28px; border-radius:10px; font-size:15px; font-weight:600; text-decoration:none; transition:transform 0.3s; border:none; cursor:pointer; box-shadow:0 4px 12px rgba(45, 80, 22, 0.3);}\n.ilmx-kedah-btn:hover {transform:scale(1.08); box-shadow:0 6px 16px rgba(45, 80, 22, 0.4);}\n.ilmx-waktu-berbuka-sahur {background:linear-gradient(135deg, #f1f8e9 0%, #dcedc8 100%);border:1px dashed #4a7c2c;color:#2d5016;padding:10px;margin:12px 0;border-radius:8px}\n.ilmx-waktu-berbuka-sahur-icon{color:#2d5016;font-size:20px;margin-bottom:0.5rem}\n.ilmx-doa-widget {all:initial; display:block; max-width:100%; margin:32px auto; font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background:linear-gradient(145deg, #0c3808 0%, #061c04 100%); border:1px solid #249749; border-top:5px solid #ffd700; border-radius:20px; padding:24px 20px; box-shadow:0 10px 30px rgba(12, 56, 8, 0.4), inset 0 0 40px rgba(36, 151, 73, 0.1); box-sizing:border-box; position:relative; overflow:hidden;}\n.ilmx-doa-widget::before {content:''; position:absolute; top:0; left:0; right:0; bottom:0; background-image:radial-gradient(#249749 1px, transparent 1px); background-size:20px 20px; opacity:0.1; pointer-events:none;}\n.ilmx-doa-header {text-align:center; position:relative; z-index:2; margin-bottom:24px;}\n.ilmx-doa-icon {font-size:32px; margin-bottom:8px; text-shadow:0 0 15px rgba(255, 215, 0, 0.5);}\n.ilmx-doa-titl