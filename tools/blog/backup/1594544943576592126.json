dah-zone-btn:hover {border-color:#4a7c2c; background:linear-gradient(135deg, #f1f8e9 0%, #dcedc8 100%); transform:translateY(-2px); box-shadow:0 4px 12px rgba(74, 124, 44, 0.2);}\n.ilmx-kedah-zone-btn.active {background:linear-gradient(135deg, #2d5016 0%, #4a7c2c 100%); border-color:#2d5016; color:#fff; transform:scale(1.05); box-shadow:0 6px 16px rgba(45, 80, 22, 0.4);}\n.ilmx-kedah-zone-number {display:block; font-size:22px; font-weight:700; margin-bottom:4px;}\n.ilmx-kedah-zone-btn.active .ilmx-kedah-zone-number {color:#ffd700;}\n.ilmx-kedah-zone-name {display:block; font-size:12px; font-weight:600; line-height:1.3;}\n.ilmx-kedah-zone-info {background:#f8f9fa; padding:16px; border-radius:12px; font-size:13px; color:#555; line-height:1.6;}\n.ilmx-kedah-zone-info strong {color:#2d5016; display:block; margin-bottom:6px;}\n.ilmx-kedah-langkawi-alert {background:linear-gradient(135deg, #2d5016 0%, #4a7c2c 50%, #2d5016 100%); border-left:4px solid #ffd700; padding:20px; border-radius:12px; margin-bottom:24px; box-shadow:0 2px 8px rgba(25, 118, 210, 0.2);}\n.ilmx-kedah-langkawi-alert h3 {font-size:17px; color:#ffca60; font-weight:700; margin-bottom:12px;}\n.ilmx-kedah-langkawi-alert p {font-size:14px; color:#fff; margin-bottom:8px; line-height:1.6;}\n.ilmx-kedah-calendar-wrap {overflow-x:auto; margin-bottom:24px; -webkit-overflow-scrolling:touch; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,0.1);}\n.ilmx-kedah-table {width:100%; border-collapse:collapse; background:#fff; min-width:600px;}\n.ilmx-kedah-table thead {background:linear-gradient(135deg, #2d5016 0%, #4a7c2c 100%); color:#fff;}\n.ilmx-kedah-table th {padding:16px 12px; color:#fff!important; font-size:14px; font-weight:600; text-align:left;}\n.ilmx-kedah-table td {padding:14px 12px; font-size:14px; border-bottom:1px solid #f0f0f0;}\n.ilmx-kedah-table tbody tr:hover {background:#f1f8e9;}\n.ilmx-kedah-table tbody tr.today {background:linear-gradient(135deg, #fffde7 0%, #fff9c4 100%); border-left:5px solid 