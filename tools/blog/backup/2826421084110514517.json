d #d4edda; border-radius:10px; padding:10px 14px; font-size:14px; font-weight:600; color:#333; cursor:pointer; touch-action:manipulation}\n.ilmx-fr-check-item input {width:18px; height:18px; accent-color:#249749; flex-shrink:0}\n.ilmx-fr-num-grid {display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px}\n.ilmx-fr-num-item {background:#f6fcf7; border:1.5px solid #d4edda; border-radius:10px; padding:10px 14px}\n.ilmx-fr-num-item label {font-size:12.5px; font-weight:700; color:#1a6614; margin-bottom:6px}\n.ilmx-fr-num-item input {width:100%; border:1.5px solid #c8e6cf; border-radius:8px; padding:8px 10px; font-size:15px; font-family:inherit; font-weight:700; color:#0c3808; background:#fff}\n.ilmx-fr-calc-btn {width:100%; background:linear-gradient(135deg,#249749,#1a6614); color:#fff; font-size:16px; font-weight:800; padding:14px; border:none; border-radius:12px; cursor:pointer; margin-top:6px; touch-action:manipulation; font-family:inherit; transition:transform .15s}\n.ilmx-fr-calc-btn:active {transform:scale(.98)}\n.ilmx-fr-result {display:none; margin-top:22px; padding-top:20px; border-top:2px dashed #e0d59a}\n.ilmx-fr-result.active {display:block}\n.ilmx-fr-result h4 {font-size:15px; font-weight:800; color:#0c3808; margin-bottom:12px; text-align:center}\n.ilmx-fr-table {width:100%; border-collapse:collapse; font-size:14px}\n.ilmx-fr-table th {background:#0c3808; color:#fff!important; padding:10px 12px; text-align:left; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px}\n.ilmx-fr-table th:last-child, .ilmx-fr-table td:last-child {text-align:right}\n.ilmx-fr-table td {padding:11px 12px; border-bottom:1px solid #eee; color:#333; font-weight:600}\n.ilmx-fr-table td:last-child {color:#249749; font-weight:800}\n.ilmx-fr-table tr:nth-child(even) {background:#f9fdf9}\n.ilmx-fr-note {background:#eaf4ff; border:1px solid #90caff; border-left:4px solid #2196f3; color:#0d3a6e; font-size:13.5px; padding:12px 14px; border-radius:8px; margin-bottom:12px; line-height:1.6}\n.ilmx-fr-empty {text-align:center; color:#999; font-size:14px; padding:10px 0}\n.ilmx-fr-disclaimer {background:#fff0f0; border:1px solid #ffb3b3; border-left:4px solid #e53935; color:#5a1a1a; font-size:13px; padding:12px 14px; border-radius:8px; margin-top:16px; line-height:1.6}\n.ilmx-fr-matrix-wrap {overflow-x:auto; margin:18px 0; border-radius:12px; border:1px solid #d4edda}\n.ilmx-fr-matrix {width:100%; border-collapse:collapse; font-size:14px; min-width:560px}\n.ilmx-fr-matrix th {background:#0c3808; color:#fff!important; padding:11px 14px; text-align:left; font-size:12.5px; text-transform:uppercase}\n.ilmx-fr-matrix td {padding:11px 14px; border-bottom:1px solid #eee; color:#333}\n.ilmx-fr-matrix tr:nth-child(even) {background:#f9fdf9}\n.ilmx-fr-hukum-badge {display:inline-block; font-size:11.5px; font-weight:700; padding:3px 10px; border-radius:20px}\n.hb-tetap {background:#e6f7eb; color:#1a6614}\n.hb-asabah {background:#fff8e6; color:#8a6d00}\n.hb-syarat {background:#eaf4ff; color:#0d3a6e}\n.ilmx-aas-steps {list-style:none!important; margin:16px 0 24px!important; padding:0!important;}\n.ilmx-aas-steps li {list-style:none!important; display:flex; align-items:flex-start; gap:12px; padding:12px 16px; border-radius:10px; margin-bottom:8px; font-size:15px; color:#333; line-height:1.6; background:#f6fcf7; border:1px solid #d4edda;}\n.ilmx-aas-steps li::before {content:none!important; display:none!important;}\n.ilmx-aas-steps li .sn {display:inline-flex; align-items:center; justify-content:center; min-width:28px; height:28px; background:#249749; color:#fff; border-radius:50%; font-size:13px; font-weight:800; margin-top:1px; flex-shrink:0;}\n.ilmx-fr-grid {display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:14px; margin:20px 0}\n.ilmx-fr-card {background:#fff; border:1px solid #d4edda; border-radius:12px; padding:18px 16px; box-shadow:0 2px 10px rgba(36,151,73,.07)}\n.ilmx-fr-card .icon {font-size:28px; margin-bottom:8px}\n.ilmx-fr-card h3 {font-size:14px; font-weight:700; color:#0c3808; margin:0 0 6px}\n.ilmx-fr-card p {font-size:13px; color:#555; margin:0; line-height:1.55}\n.ilmx-fr-faq {margin:28px 0}\n.ilmx-fr-faq-item {border:1px solid #d4edda; border-radius:10px; margin-bottom:8px; overflow:hidden}\n.ilmx-fr-faq-q {width:100%; background:#f6fcf7; border:none; text-align:left; padding:15px 18px; font-size:15px; font-weight:700; color:#0c3808; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:10px; touch-action:manipulation; font-family:inherit; line-height:1.5}\n.ilmx-fr-faq-q .arr {font-size:16px; flex-shrink:0; transition:transform .25s; color:#249749}\n.ilmx-fr-faq-q.open .arr {transform:rotate(180deg)}\n.ilmx-fr-faq-a {display:none; padding:0 18px 16px; font-size:15px; color:#444; line-height:1.7; background:#fff}\n.ilmx-fr-faq-a.open {display:block}\n.ilmx-fr-cta-green {background:linear-gradient(135deg,#0c3808,#249749); border-radius:14px; padding:28px; margin:30px 0; text-align:center}\n.ilmx-fr-cta-green h3 {font-size:17px; font-weight:800; color:#fff; margin:0 0 7px}\n.ilmx-fr-cta-green p {color:rgba(255,255,255,.85); font-size:14px; margin:0 0 14px}\n.ilmx-fr-cta-btn {display:inline-block; background:#fff; color:#0c3808; font-size:14px; font-weight:800; padding:11px 26px; border-radius:8px; text-decoration:none; cursor:pointer; border:none; transition:transform .15s; touch-action:manipulation; font-family:inherit}\n.ilmx-fr-cta-btn:active {transform:scale(.97)}\n.ilmx-fr-hr {border:none; border-top:2px solid #e8f5ea; margin:32px 0}\n.ilmx-fr-cluster-grid {display:grid; grid-template-columns:repeat(auto-fit,minmax(195px,1fr)); gap:10px; margin:14px 0}\n.ilmx-fr-cluster-item {background:#f6fcf7; border:1px solid #d4edda; border-radius:10px; padding:13px 15px; text-decoration:none; color:#0c3808; font-size:14px; font-weight:600; display:flex; align-items:center; gap:8px; transition:all .15s}\n.ilmx-fr-cluster-item:hover {background:#e6f7eb; border-color:#249749}\n\n\n.ilmx-aas-steps ul, .ilmx-aas-steps ol, .ilmx-aas-steps li {list-style:none !important; list-style-type:none !important;}\n.ilmx-aas-steps li::before, .ilmx-aas-steps li::after {display:none !important; content:none !important; background:none !important; width:0 !important; height:0 !important; margin:0 !important; padding:0 !important;}\n@media(max-width:640px) {\n.ilmx-fr-hero {padding:32px 16px 28px}\n.ilmx-fr-calc {padding:20px 16px}\n}\n</style>\n<script>\n(function(){\n'use strict';\n\nvar BASE = 24;\n\nfunction byId(id){\n  return document.getElementById(id);\n}\n\nfunction getCheckedValue(name){\n  var item = document.querySelector('input[name=\"' + name + '\"]:checked');\n  return item ? item.value : '';\n}\n\nfunction clampNumber(value, min, max){\n  var n = parseInt(value, 10);\n  if (isNaN(n)) { n = min; }\n  if (n < min) { n = min; }\n  if (n > max) { n = max; }\n  return n;\n}\n\nfunction getInputBounds(input){\n  var min = parseInt(input.min, 10);\n  var max = parseInt(input.max, 10);\n  return {\n    min: isNaN(min) ? 0 : min,\n    max: isNaN(max) ? 999 : max\n  };\n}\n\nfunction setNumberValue(input, value){\n  var bounds = getInputBounds(input);\n  var next = clampNumber(value, bounds.min, bounds.max);\n  input.value = String(next);\n  updateStepperState(input);\n  return next;\n}\n\nfunction getNumberValue(id){\n  var input = byId(id);\n  return input ? setNumberValue(input, input.value) : 0;\n}\n\nfunction updateStepperState(input){\n  var stepper = input.closest ? input.closest('[data-stepper]') : null;\n  if (!stepper) { return; }\n  var bounds = getInputBounds(input);\n  var value = clampNumber(input.value, bounds.min, bounds.max);\n  stepper.querySelectorAll('[data-step]').forEach(function(btn){\n    var step = parseInt(btn.getAttribute('data-step'), 10) || 0;\n    btn.disabled = (step < 0 && value <= bounds.min) || (step > 0 && value >= bounds.max);\n  });\n}\n\nfunction updatePasanganLabel(){\n  var jantina = getCheckedValue('ilmx-fr-jantina') || 'L';\n  var lbl = byId('ilmx-fr-pasangan-label');\n  var inp = byId('ilmx-fr-pasangan');\n  if (!lbl || !inp) { return; }\n\n  if (jantina === 'L') {\n    lbl.textContent = 'Bilangan Isteri (0-4)';\n    inp.max = '4';\n  } else {\n    lbl.textContent = 'Ada Suami? (0 atau 1)';\n    inp.max = '1';\n  }\n  setNumberValue(inp, inp.value);\n}\n\nfunction initNumberControls(){\n  document.querySelectorAll('[data-stepper]').forEach(function(stepper){\n    var input = stepper.querySelector('input[type=\"number\"]');\n    if (!input) { return; }\n\n    stepper.querySelectorAll('[data-step]').forEach(function(btn){\n      btn.addEventListener('click', function(){\n        var step = parseInt(btn.getAttribute('data-step'), 10) || 0;\n        var current = parseInt(input.value, 10);\n        if (isNaN(current)) { current = getInputBounds(input).min; }\n        setNumberValue(input, current + step);\n        input.dispatchEvent(new Event('change', {bubbles:true}));\n      });\n    });\n\n    input.addEventListener('input', function(){\n      input.value = input.value.replace(/[^0-9]/g, '');\n      updateStepperState(input);\n    });\n    input.addEventListener('blur', function(){ setNumberValue(input, input.value); });\n    input.addEventListener('change', function(){ setNumberValue(input, input.value); });\n    setNumberValue(input, input.value);\n  });\n}\n\nfunction hitungFaraidCore(d){\n  var used = 0;\n  var shares = [], asabah = [];\n  var hasAnak = (d.anakL > 0 || d.anakP > 0);\n  var bapaAda = d.bapa;\n  var datukAda = !bapaAda && d.datuk;\n  var ibuAda = d.ibu;\n  var nenekAda = !ibuAda && d.nenek;\n  var saudaraDihalang = bapaAda || datukAda || (d.anakL > 0);\n  var saudL = saudaraDihalang ? 0 : d.saudL;\n  var saudP = saudaraDihalang ? 0 : d.saudP;\n  var hasSaudara = (saudL > 0 || saudP > 0);\n\n  if (d.jantina === 'L' && d.pasangan > 0) {\n    var vI = hasAnak ? BASE / 8 : BASE / 4;\n    shares.push({label:'Isteri' + (d.pasangan > 1 ? ' (kongsi ' + d.pasangan + ' orang)' : ''), val:vI, isSpouse:true});\n    used += vI;\n  } else if (d.jantina === 'P' && d.pasangan > 0) {\n    var vS = hasAnak ? BASE / 4 : BASE / 2;\n    shares.push({label:'Suami', val:vS, isSpouse:true});\n    used += vS;\n  }\n\n  var siblingCountForHijab = saudL + saudP;\n  var gharrawain = ibuAda && bapaAda && !hasAnak && !hasSaudara && d.pasangan > 0;\n\n  if (ibuAda) {\n    var vIb;\n    if (gharrawain) { vIb = (BASE - used) / 3; }\n    else if (hasAnak || siblingCountForHijab >= 2) { vIb = BASE / 6; }\n    else { vIb = BASE / 3; }\n    shares.push({label:'Ibu', val:vIb});\n    used += vIb;\n  }\n\n  if (nenekAda) {\n    shares.push({label:'Nenek', val:BASE / 6});\n    used += BASE / 6;\n  }\n\n  if (bapaAda) {\n    if (hasAnak) {\n      shares.push({label:'Bapa', val:BASE / 6});\n      used += BASE / 6;\n      if (d.anakL === 0 && d.anakP > 0) { asabah.push({label:'Bapa (baki sebagai asabah)', weight:1}); }\n    } else {\n      asabah.push({label:'Bapa', weight:1});\n    }\n  } else if (datukAda) {\n    if (hasAnak) {\n      shares.push({label:'Datuk', val:BASE / 6});\n      used += BASE / 6;\n      if (d.anakL === 0 && d.anakP > 0) { asabah.push({label:'Datuk (baki sebagai asabah)', weight:1}); }\n    } else {\n      asabah.push({label:'Datuk', weight:1});\n    }\n  }\n\n  if (d.anakL > 0) {\n    asabah.push({label:'Anak Lelaki (' + d.anakL + ' orang, kongsi)', weight:2 * d.anakL});\n    if (d.anakP > 0) { asabah.push({label:'Anak Perempuan (' + d.anakP + ' orang, asabah bersama)', weight:d.anakP}); }\n  } else if (d.anakP > 0) {\n    var vAP = d.anakP === 1 ? BASE / 2 : BASE * 2 / 3;\n    shares.push({label:'Anak Perempuan (' + d.anakP + ' orang, kongsi)', val:vAP});\n    used += vAP;\n  }\n\n  if (hasSaudara) {\n    if (saudL > 0) {\n      asabah.push({label:'Saudara Lelaki Seibu Sebapa (' + saudL + ' orang, kongsi)', weight:2 * saudL});\n      if (saudP > 0) { asabah.push({label:'Saudara Perempuan Seibu Sebapa (' + saudP + ' orang, asabah bersama)', weight:saudP}); }\n    } else {\n      var vSP = saudP === 1 ? BASE / 2 : BASE * 2 / 3;\n      shares.push({label:'Saudara Perempuan Seibu Sebapa (' + saudP + ' orang, kongsi)', val:vSP});\n      used += vSP;\n    }\n  }\n\n  var baki = BASE - used;\n  var results = [], awl = false, radd = false, baitulmal = false;\n\n  if (used > BASE + 0.0005) {\n    awl = true;\n    var factor = BASE / used;\n    shares.forEach(function(s){ results.push({label:s.label, portion:s.val * factor}); });\n  } else if (asabah.length > 0) {\n    var totalW = 0;\n    asabah.forEach(function(a){ totalW += a.weight; });\n    shares.forEach(function(s){ results.push({label:s.label, portion:s.val}); });\n    asabah.forEach(function(a){ results.push({label:a.label, portion:baki * (a.weight / totalW)}); });\n  } else if (baki > 0.0005) {\n    var totalR = 0;\n    shares.forEach(function(s){ if (!s.isSpouse) { totalR += s.val; } });\n    if (totalR > 0) {\n      radd = true;\n      shares.forEach(function(s){\n        if (s.isSpouse) { results.push({label:s.label, portion:s.val}); }\n        else { results.push({label:s.label, portion:s.val + baki * (s.val / totalR)}); }\n      });\n    } else {\n      baitulmal = true;\n      shares.forEach(function(s){ results.push({label:s.label, portion:s.val}); });\n      results.push({label:'Baki / Baitulmal', portion:baki});\n    }\n  } else {\n    shares.forEach(function(s){ results.push({label:s.label, portion:s.val}); });\n  }\n\n  return {results:results, awl:awl, radd:radd, baitulmal:baitulmal, gharrawain:gharrawain, hasAny:shares.length > 0 || asabah.length > 0};\n}\n\nwindow.ilmxFrKira = function(){\n  var d = {\n    jantina: getCheckedValue('ilmx-fr-jantina') || 'L',\n    pasangan: getNumberValue('ilmx-fr-pasangan'),\n    bapa: !!(byId('ilmx-fr-bapa') && byId('ilmx-fr-bapa').checked),\n    ibu: !!(byId('ilmx-fr-ibu') && byId('ilmx-fr-ibu').checked),\n    datuk: !!(byId('ilmx-fr-datuk') && byId('ilmx-fr-datuk').checked),\n    nenek: !!(byId('ilmx-fr-nenek') && byId('ilmx-fr-nenek').checked),\n    anakL: getNumberValue('ilmx-fr-anakl'),\n    anakP: getNumberValue('ilmx-fr-anakp'),\n    saudL: getNumberValue('ilmx-fr-saudl'),\n    saudP: getNumberValue('ilmx-fr-saudp')\n  };\n  renderFrResult(hitungFaraidCore(d));\n};\n\nfunction formatPct(portion){\n  return ((portion / BASE) * 100).toFixed(2) + '%';\n}\n\nfunction renderFrResult(r){\n  var box = byId('ilmx-fr-result');\n  if (!box) { return; }\n  var html = '';\n  if (!r.hasAny) {\n    html = '<p class=\"ilmx-fr-empty\">Sila tandakan sekurang-kurangnya seorang waris untuk mengira.</p>';\n  } else {\n    if (r.gharrawain) { html += '<div class=\"ilmx-fr-note\">Kes Gharrawain dikesan: kadar Ibu dikira 1/3 daripada baki selepas bahagian pasangan.</div>'; }\n    if (r.awl) { html += '<div class=\"ilmx-fr-note\">Berlaku Aul: jumlah bahagian asal melebihi keseluruhan harta, jadi semua bahagian dikurangkan mengikut nisbah supaya jumlah tepat 100%.</div>'; }\n    if (r.radd) { html += '<div class=\"ilmx-fr-note\">Berlaku Radd: baki harta dikembalikan kepada waris furudh selain pasangan mengikut nisbah.</div>'; }\n    if (r.baitulmal) { html += '<div class=\"ilmx-fr-note\">Tiada asabah atau waris radd selain pasangan. Baki ditunjukkan sebagai Baki / Baitulmal supaya jumlah peratus kekal 100%.</div>'; }\n    html += '<h4>Anggaran Bahagian Setiap Waris</h4>';\n    html += '<table class=\"ilmx-fr-table\"><thead><tr><th>Waris</th><th>Bahagian</th></tr></thead><tbody>';\n    var total = 0;\n    r.results.forEach(function(x){\n      total += x.portion;\n      html += '<tr><td>' + x.label + '</td><td>' + formatPct(x.portion) + '</td></tr>';\n    });\n    html += '<tr class=\"ilmx-fr-total\"><td>Jumlah</td><td>' + formatPct(total) + '</td></tr>';\n    html += '</tbody></table>';\n  }\n  box.innerHTML = html;\n  box.classList.add('active');\n}\n\nwindow.ilmxFrFaq = function(btn){\n  var isOpen = btn.classList.contains('open');\n  document.querySelectorAll('.ilmx-fr-faq-q').forEach(function(q){ q.classList.remove('open'); });\n  document.querySelectorAll('.ilmx-fr-faq-a').forEach(function(a){ a.classList.remove('open'); });\n  if (!isOpen) {\n    btn.classList.add('open');\n    var a = btn.nextElementSibling;\n    if (a) { a.classList.add('open'); }\n  }\n};\n\nfunction initFaraidCalculator(){\n  document.querySelectorAll('input[name=\"ilmx-fr-jantina\"]').forEach(function(radio){\n    radio.addEventListener('change', updatePasanganLabel);\n  });\n  initNumberControls();\n  updatePasanganLabel();\n}\n\nif (document.readyState === 'loading') {\n  document.addEventListener('DOMContentLoaded', initFaraidCalculator);\n} else {\n  initFaraidCalculator();\n}\n})();\n</script>\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[\n{\"@type\":\"WebPage\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\".ilmx-fr-answer\"]}},\n{\"@type\":\"WebApplication\",\"name\":\"Kalkulator Faraid\",\"applicationCategory\":\"UtilityApplication\",\"operatingSystem\":\"Web\",\"url\":\"https://www.ilmualam.com/2026/08/faraid-suami-isteri-meninggal-tanpa-anak.html\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"MYR\"}},\n{\"@type\":\"FAQPage\",\"mainEntity\":[\n{\"@type\":\"Question\",\"name\":\"Adakah faraid boleh diubah suai mengikut persetujuan keluarga?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Kadar asas faraid tidak boleh diubah sewenang-wenangnya. Namun waris mukallaf boleh secara sukarela melepaskan bahagian mereka selepas pembahagian sah ditentukan - dipanggil tanazul, berbeza daripada mengubah hukum faraid itu sendiri.\"}},\n{\"@type\":\"Question\",\"name\":\"Kalau anak perempuan sahaja, siapa dapat baki selepas 2/3 diagihkan?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Jika bapa masih hidup, bapa menerima 1/6 tetap dan baki sebagai asabah. Jika bapa tiada, saudara lelaki si mati menjadi asabah. Jika tiada asabah, baki dikembalikan (radd) kepada anak perempuan dan waris furudh lain.\"}},\n{\"@type\":\"Question\",\"name\":\"Adakah anak angkat berhak menerima faraid?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tidak. Anak angkat tidak termasuk waris faraid kerana ia berasaskan nasab atau perkahwinan sah. Ibu bapa angkat digalakkan menyediakan wasiat maksimum 1/3 harta untuk anak angkat mereka.\"}},\n{\"@type\":\"Question\",\"name\":\"Bagaimana jika salah seorang waris bukan beragama Islam?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Waris bukan Islam pada masa kematian si mati terhalang sepenuhnya daripada faraid, berdasarkan hadis riwayat Bukhari No. 6764 dan Muslim No. 1614. Si mati boleh menyediakan wasiat had 1/3 harta untuk mereka semasa hayat.\"}},\n{\"@type\":\"Question\",\"name\":\"Perlukah zakat dikeluarkan daripada harta pusaka sebelum faraid?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ya, jika si mati mempunyai zakat tertunggak. Zakat yang belum ditunaikan dikira hutang kepada Allah dan wajib dilangsaikan daripada harta pusaka sebelum sebarang pembahagian faraid.\"}},\n{\"@type\":\"Question\",\"name\":\"Kalkulator ini sah untuk digunakan di Mahkamah Syariah?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tidak. Kalkulator ini alat panduan pendidikan sahaja. Pembahagian rasmi mesti melalui Sijil Faraid daripada Mahkamah Syariah atau Amanah Raya Berhad.\"}},\n{\"@type\":\"Question\",\"name\":\"Apa beza asabah bin nafsih dengan asabah bil ghair?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Asabah bin nafsih ialah waris lelaki yang menjadi asabah dengan sendirinya seperti anak lelaki atau bapa. Asabah bil ghair ialah waris perempuan yang menjadi asabah kerana kewujudan saudara lelaki setaraf, dengan kadar lelaki dua kali kadar perempuan.\"}},\n{\"@type\":\"Question\",\"name\":\"Berapa lama proses mendapatkan Sijil Faraid di Malaysia?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Secara amnya antara 1 hingga 3 bulan jika dokumen lengkap dan tiada pertikaian waris. Kes yang melibatkan waris luar negara atau harta bernilai tinggi boleh mengambil masa lebih lama.\"}}\n]},\n{\"@type\":\"BreadcrumbList\",\"itemListElement\":[\n{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Utama\",\"item\":\"https://ilmualam.com\"},\n{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Fiqh Muamalat\",\"item\":\"https://ilmualam.com/kategori/fiqh-muamalat\"},\n{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Faraid Suami/Isteri Meninggal Tanpa Anak: Siapa Dapat Apa?\",\"item\":\"https://www.ilmualam.com/2026/08/faraid-suami-isteri-meninggal-tanpa-anak.html\"}\n]}\n]}\n</script>",
 "author": {
