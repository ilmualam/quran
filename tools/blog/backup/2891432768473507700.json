erlis.min.js?v=20260221-1.2\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"name\":\"Jadual Imsak Berbuka Puasa Perlis 2026\",\"url\":\"https://www.ilmualam.com/2022/03/waktu-berbuka-puasa-perlis.html\",\"description\":\"JJadual rasmi waktu berbuka & imsak Ramadan 1447H/2026 Perlis Indera Kayangan. Panduan lengkap pekerja sempadan Thailand + Padang Besar. JAKIM & Mufti\",\"inLanguage\":\"ms-MY\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"IlmuAlam\",\"url\":\"https://ilmualam.com\"}},{\"@type\":\"WebApplication\",\"name\":\"Jadual Ramadan Perlis 2026 &#8211; 7 Zon\",\"applicationCategory\":\"UtilityApplication\",\"operatingSystem\":\"Any\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"MYR\"},\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":\"4.9\",\"ratingCount\":\"2780\"}},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"🤔 Berbeza berapa minit waktu berbuka Perlis vs Thailand?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Thailand Maghrib lewat 10-15 minit dari Perlis. Contoh: Perlis berbuka 7:28pm, Thailand mungkin 7:40pm. PENTING: Jika anda di Thailand, MESTI ikut waktu Thailand - jangan berbuka awal!\"}},{\"@type\":\"Question\",\"name\":\"🤔 Padang Besar station ada surau untuk solat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ada, tapi kecil. Cukup untuk Zohor/Asar commuters. Untuk berbuka, boleh beli makanan dari duty free atau food court station (check operating hours). Ramai border workers solat &amp; berbuka sini before sambung journey.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Kalau stuck di immigration waktu berbuka macam mana?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"MESTI bawa kurma &amp; air dalam kereta! Ini survival kit wajib. Jika terpaksa, boleh berbuka darurat dalam kereta di immigration line - Islam benarkan dalam keadaan musafir/emergency. Lepas berbuka simple, sambung proses immigration.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Better berbuka di Thailand atau balik Perlis?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Bergantung lokasi &amp; timing. Jika kerja jauh dari sempadan (e.g. Hat Yai downtown), better berbuka di Thailand dulu - masjid ada berbuka percuma, restaurants Muslim banyak. Jika kerja dekat sempadan &amp; yakin boleh sampai Perlis 6pm+, boleh balik berbuka. Yang penting: safety first, bawa kurma emergency!\"}},{\"@type\":\"Question\",\"name\":\"🤔 Wang Kelian vs Padang Besar - which better?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Padang Besar lebih convenient - ada train station, duty free, food court, facilities complete. Wang Kelian kurang sesak but facilities basic - best for weekend crossers &amp; traders. Untuk daily commuters Ramadan: Padang Besar recommended!\"}},{\"@type\":\"Question\",\"name\":\"🤔 Apa maksud \\\"Indera Kayangan\\\"?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\\"Indera Kayangan\\\" bermaksud \\\"Taman Syurga\\\" - gelaran istimewa Perlis! Walaupun negeri terkecil Malaysia (795 km²), Perlis kaya dengan keindahan alam seperti Gua Kelam, Tasik Melati, dan kedudukan strategik sebagai gerbang ke Thailand.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Duty free Padang Besar jual kurma halal?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"YA! Duty free Padang Besar ada jual kurma import (Arab, Tunisia), air, light snacks. Harga duty free = murah! Perfect untuk stock kurma berbuka. Ramai border workers &amp; pelancong beli sini before Ramadan.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Gua Kelam buka masa Ramadan?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"BUKA! Malah best visit waktu petang before berbuka (5-6pm) - sejuk dalam gua, jalan kaki 370m walkway, cantik &amp; refreshing. After jalan-jalan Gua Kelam, boleh berbuka di Kaki Bukit town nearby. Aktiviti Ramadan yang unique!\"}}]}]}</script>",
