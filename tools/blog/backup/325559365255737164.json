a-icon {font-size:32px; margin-bottom:8px; text-shadow:0 0 15px rgba(255, 215, 0, 0.5);}\n.ilmx-doa-title {color:#ffffff; font-size:22px; font-weight:800; margin:0 0 4px 0; letter-spacing:0.5px; text-transform:uppercase;}\n.ilmx-doa-subtitle {color:#fff; font-size:13px; margin:0; font-weight:500;}\n.ilmx-doa-radio {display:none;}\n.ilmx-doa-tab-nav {display:flex; justify-content:center; gap:12px; margin-bottom:24px; position:relative; z-index:2;}\n.ilmx-doa-tab-btn {background:rgba(36, 151, 73, 0.2); color:#a8d5b2; padding:10px 24px; border-radius:30px; font-size:14px; font-weight:600; cursor:pointer; transition:all 0.3s ease; border:1px solid rgba(36, 151, 73, 0.5); user-select:none;}\n.ilmx-doa-tab-btn:hover {background:rgba(36, 151, 73, 0.4); color:#ffffff;}\n#ilmx-doa-tab-sendiri:checked ~ .ilmx-doa-tab-nav label[for=\"ilmx-doa-tab-sendiri\"], #ilmx-doa-tab-ramai:checked ~ .ilmx-doa-tab-nav label[for=\"ilmx-doa-tab-ramai\"] {background:#249749; color:#ffffff; border-color:#ffd700; box-shadow:0 4px 15px rgba(36, 151, 73, 0.6);}\n.ilmx-doa-panels {position:relative; z-index:2;}\n.ilmx-doa-panel {display:none; animation:ilmxFadeIn 0.4s ease-out forwards;}\n#ilmx-doa-tab-sendiri:checked ~ .ilmx-doa-panels .ilmx-doa-panel-sendiri, #ilmx-doa-tab-ramai:checked ~ .ilmx-doa-panels .ilmx-doa-panel-ramai {display:block;}\n.ilmx-doa-arabic {font-family:'Amiri', 'Traditional Arabic', 'KFGQPC Uthman Taha Naskh', serif; font-size:30px; font-weight:600; line-height:1.8; color:#ffd700; text-align:center; margin-bottom:20px; text-shadow:0 2px 4px rgba(0,0,0,0.5); padding:0 10px;}\n.ilmx-doa-rumi {background:rgba(0, 220, 0, 0.1); border:1px dashed #249749; border-radius:10px; color:#fff; font-size:15px; font-style:italic; padding:16px; margin-bottom:16px; line-height:1.6; text-align:center;}\n.ilmx-doa-meaning {color:#ffffff; font-size:14px; line-height:1.7; text-align:center; padding:0 10px; opacity:0.9;}\n.ilmx-doa-meaning strong {color:#ffd700;}\n.ilmx-waktu-berbuka-sahur {background:linear-gradient(135deg,#f1f8e9 0%,#e8f5e9 100%);border:1px dashed #0c3808;color:#0c3808;padding:10px;margin:12px 0;border-radius:8px}\n.ilmx-waktu-berbuka-sahur-icon{color:#0c3808;font-size:20px;margin-bottom:0.5rem}\n  \n@keyframes ilmxFadeIn {\n0% {opacity:0; transform:translateY(10px);}\n100% {opacity:1; transform:translateY(0);}\n}\n\n@media (max-width: 480px) {\n.ilmx-doa-arabic {font-size:28px;}\n.ilmx-doa-tab-btn {padding:10px 16px; font-size:13px;}\n.ilmx-doa-widget {padding:20px 15px;}\n}\n@media (max-width: 480px) {\n.ilmx-prk-container {padding:0;}\n.ilmx-prk-zone-grid {grid-template-columns:repeat(4,1fr); gap:6px;}\n.ilmx-prk-zone-grid-row2 {grid-template-columns:repeat(3, 1fr); gap:6px;}\n.ilmx-prk-zone-btn {padding:8px 4px;}\n.ilmx-prk-zone-num {font-size:13px;}\n.ilmx-prk-zone-name {font-size:12px;}\n.ilmx-prk-timer {gap:7px;}\n.ilmx-prk-time-unit {min-width:54px; padding:10px 6px;}\n.ilmx-prk-time-value {font-size:24px;}\n.ilmx-prk-table {font-size:12px;}\n.ilmx-prk-table th, .ilmx-prk-table td {padding:7px 4px;}\n}\n</style>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebApplication\",\"@id\":\"https://www.ilmualam.com/2022/03/waktu-berbuka-puasa-perak.html#tool\",\"name\":\"Tool Jadual Waktu Berbuka & Imsak Perak 2026 (7 Zon)\",\"applicationCategory\":\"UtilityApplication\",\"operatingSystem\":\"Any\",\"featureList\":[\"7 zon interaktif Perak\",\"Countdown timer real-time\",\"Jadual 30 hari Ramadan\",\"Data rasmi JAKIM\"],\"offers\":{\"@type\":\"Offer\",\"price\":\"0.00\",\"priceCurrency\":\"MYR\"}},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"🤔 Berapa zon waktu solat di Perak?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Perak mempunyai 7 zon waktu solat - paling banyak di Semenanjung Malaysia. Ini kerana keluasan dan kepelbagaian topografi Perak, dari kawasan pantai, pedalaman, hingga kawasan tinggi seperti Bukit Larut.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Bila waktu berbuka puasa Ipoh 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ipoh berada dalam Zon 2. Waktu berbuka puasa hari pertama Ramadan 2026 di Ipoh ialah 7:31 malam. Waktu imsak ialah 6:12 pagi.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Kenapa Bukit Larut (Zon 7) berbuka paling lewat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Bukit Larut (Maxwell Hill) berada pada ketinggian 1,040m. Pada ketinggian yang lebih tinggi, horizon matahari menjadi lebih jauh, menyebabkan matahari terbenam lebih lewat berbanding kawasan bawah. Zon 7 berbuka pada 7:36 malam - sekitar 4-7 minit lebih lewat dari zon lain di Perak!\"}},{\"@type\":\"Question\",\"name\":\"🤔 Zon mana untuk Tanjung Malim dan Slim River?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tanjung Malim dan Slim River berada dalam Zon 1. Kawasan ini adalah yang paling selatan Perak, bersempadan dengan Selangor. Waktu berbuka hari pertama ialah 7:30 malam.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Bila waktu berbuka di Taiping, Perak 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Taiping berada dalam Zon 6 bersama Selama, Bagan Serai, dan Parit Buntar. Waktu berbuka hari pertama Ramadan ialah 7:32 malam.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Waktu berbuka puasa di Teluk Intan 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Teluk Intan berada dalam Zon 5 bersama Lumut, Sitiawan, dan Pulau Pangkor. Waktu berbuka hari pertama ialah 7:32 malam.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Zon mana untuk Royal Belum dan Temengor?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Hutan Belum dan Empangan Temengor berada dalam Zon 4. Waktu berbuka hari pertama ialah 7:29 malam.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Adakah waktu solat Perak berbeza dengan Selangor?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ya. Kawasan Tanjung Malim (Perak Zon 1) berhampiran dengan Selangor tetapi mempunyai jadual berbeza. Perak menggunakan bidang kuasa Jabatan Mufti Perak manakala Selangor di bawah Jabatan Mufti Selangor.\"}}]}]}</script>\n<script src=\"https://cdn.jsdelivr.net/gh/ilmualam/ramadan@main/asset/perak.min.js?v=20260221-1.2\" defer></script>",
