.6; color:#333; margin-bottom:12px;}\n.ilmx-doa-widget {all:initial; display:block; max-width:100%; margin:32px auto; font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background:linear-gradient(145deg, #0c3808 0%, #061c04 100%); border:1px solid #249749; border-top:5px solid #ffd700; border-radius:20px; padding:24px 20px; box-shadow:0 10px 30px rgba(12, 56, 8, 0.4), inset 0 0 40px rgba(36, 151, 73, 0.1); box-sizing:border-box; position:relative; overflow:hidden;}\n.ilmx-doa-widget::before {content:''; position:absolute; top:0; left:0; right:0; bottom:0; background-image:radial-gradient(#249749 1px, transparent 1px); background-size:20px 20px; opacity:0.1; pointer-events:none;}\n.ilmx-doa-header {text-align:center; position:relative; z-index:2; margin-bottom:24px;}\n.ilmx-doa-icon {font-size:32px; margin-bottom:8px; text-shadow:0 0 15px rgba(255, 215, 0, 0.5);}\n.ilmx-doa-title {color:#ffffff; font-size:22px; font-weight:800; margin:0 0 4px 0; letter-spacing:0.5px; text-transform:uppercase;}\n.ilmx-doa-subtitle {color:#fff; font-size:13px; margin:0; font-weight:500;}\n.ilmx-doa-radio {display:none;}\n.ilmx-doa-tab-nav {display:flex; justify-content:center; gap:12px; margin-bottom:24px; position:relative; z-index:2;}\n.ilmx-doa-tab-btn {background:rgba(36, 151, 73, 0.2); color:#a8d5b2; padding:10px 24px; border-radius:30px; font-size:14px; font-weight:600; cursor:pointer; transition:all 0.3s ease; border:1px solid rgba(36, 151, 73, 0.5); user-select:none;}\n.ilmx-doa-tab-btn:hover {background:rgba(36, 151, 73, 0.4); color:#ffffff;}\n#ilmx-doa-tab-sendiri:checked ~ .ilmx-doa-tab-nav label[for=\"ilmx-doa-tab-sendiri\"], #ilmx-doa-tab-ramai:checked ~ .ilmx-doa-tab-nav label[for=\"ilmx-doa-tab-ramai\"] {background:#249749; color:#ffffff; border-color:#ffd700; box-shadow:0 4px 15px rgba(36, 151, 73, 0.6);}\n.ilmx-doa-panels {position:relative; z-index:2;}\n.ilmx-doa-panel {display:none; animation:ilmxFadeIn 0.4s ease-out forwards;}\n#ilmx-doa-tab-sendiri:checked ~ .ilmx-doa-panels .ilmx-doa-panel-sendiri, #ilmx-doa-tab-ramai:checked ~ .ilmx-doa-panels .ilmx-doa-panel-ramai {display:block;}\n.ilmx-doa-arabic {font-family:'Amiri', 'Traditional Arabic', 'KFGQPC Uthman Taha Naskh', serif; font-size:30px; font-weight:600; line-height:1.8; color:#ffd700; text-align:center; margin-bottom:20px; text-shadow:0 2px 4px rgba(0,0,0,0.5); padding:0 10px;}\n.ilmx-doa-rumi {background:rgba(0, 220, 0, 0.1); border:1px dashed #249749; border-radius:10px; color:#fff; font-size:15px; font-style:italic; padding:16px; margin-bottom:16px; line-height:1.6; text-align:center;}\n.ilmx-doa-meaning {color:#ffffff; font-size:14px; line-height:1.7; text-align:center; padding:0 10px; opacity:0.9;}\n.ilmx-doa-meaning strong {color:#ffd700;}\n.ilmx-waktu-berbuka-sahur {background:linear-gradient(135deg,#f1f8e9 0%,#e8f5e9 100%); border:1px dashed #0c3808; color:#0c3808; padding:10px; margin:12px 0; border-radius:8px}\n.ilmx-waktu-berbuka-sahur-icon {color:#0c3808; font-size:20px; margin-bottom:0.5rem}\n\n@keyframes ilmxFadeIn {\n0% {opacity:0; transform:translateY(10px);}\n100% {opacity:1; transform:translateY(0);}\n}\n\n@media (max-width: 480px) {\n.ilmx-doa-arabic {font-size:28px;}\n.ilmx-doa-tab-btn {padding:10px 16px; font-size:13px;}\n.ilmx-doa-widget {padding:20px 15px;}\n}\n\n@media (max-width: 480px) {\n.ilmx-n9-container {padding:0;}\n.ilmx-n9-zone-grid {grid-template-columns:1fr 1fr 1fr; gap:7px;}\n.ilmx-n9-zone-btn {padding:10px 6px;}\n.ilmx-n9-zone-name {font-size:10px;}\n.ilmx-n9-timer {gap:8px;}\n.ilmx-n9-time-unit {min-width:56px; padding:10px 6px;}\n.ilmx-n9-time-value {font-size:24px;}\n.ilmx-n9-table {font-size:12px;}\n.ilmx-n9-table th, .ilmx-n9-table td {padding:7px 4px;}\n}\n</style>\n<script src=\"https://cdn.jsdelivr.net/gh/ilmualam/ramadan@main/asset/ns.min.js?v=20260221-1.2\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebApplication\",\"@id\":\"https://www.ilmualam.com/2022/03/waktu-berbuka-puasa-negeri-sembilan.html#tool\",\"name\":\"Tool Jadual Waktu Berbuka &amp; Imsak Negeri Sembilan 2026 (3 Zon)\",\"applicationCategory\":\"UtilityApplication\",\"operatingSystem\":\"Any\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"MYR\"}},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"🤔 Berapa zon waktu solat di Negeri Sembilan?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Negeri Sembilan mempunyai 3 zon waktu solat: Zon 1 (Tampin &amp; Jempol), Zon 2 (Jelebu, Kuala Pilah &amp; Rembau), dan Zon 3 (Seremban &amp; Port Dickson). Setiap zon berbeza 1-2 minit. Semak zon anda menggunakan pemilih zon di atas.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Bila waktu berbuka puasa Seremban 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Seremban berada dalam Zon 3. Waktu berbuka puasa hari pertama Ramadan 2026 di Seremban ialah 7:29 malam. Waktu imsak ialah 6:06 pagi. Pilih Zon 3 dalam pemilih di atas untuk jadual penuh.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Bilakah waktu berbuka puasa Port Dickson 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Port Dickson (PD) juga berada dalam Zon 3 bersama Seremban. Waktu berbuka hari pertama ialah 7:29 malam. Penikmat tepi pantai PD boleh berbuka sambil menikmati pemandangan matahari terbenam di Selat Melaka.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Zon mana untuk Nilai dan Bandar Baru Enstek?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nilai, Bandar Baru Enstek, Sepang (bahagian N9) dan kawasan sekitarnya termasuk dalam Zon 3 (Seremban &amp; Port Dickson). Gunakan waktu berbuka Zon 3 sebagai panduan anda.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Kenapa waktu berbuka berbeza antara Tampin dan Seremban?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Perbezaan sekitar 2 minit ini disebabkan oleh kedudukan geografi. Tampin terletak lebih ke selatan-timur, matahari terbenam sedikit lebih awal berbanding Seremban yang lebih ke barat. JAKIM menggunakan kaedah kiraan astronomi yang tepat berdasarkan koordinat setiap kawasan.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Boleh saya guna jadual Selangor jika duduk di Nilai, N9?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tidak disyorkan. Walaupun Nilai berhampiran sempadan Selangor, ia berada di bawah bidang kuasa Jabatan Mufti Negeri Sembilan (Zon 3). Perbezaan mungkin 1-3 minit. Untuk ketepatan dan kesahihan ibadah, gunakan jadual rasmi N. Sembilan Zon 3.\"}},{\"@type\":\"Question\",\"name\":\"🤔 Di mana Bazaar Ramadan terbaik di N. Sembilan 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Bazaar Ramadan yang popular termasuk Bazaar Seremban 2, Bazaar Tembok Seremban, Bazaar Nilai, Bazaar Kuala Pilah, dan Bazaar PD Waterfront. Setiap bazaar menawarkan makanan tradisi N9 yang unik seperti Masak Lemak Cili Api dan Nasi Ambang.\"}}]}]}</script>\n<script src=\"https://cdn.jsdelivr.net/gh/ilmualam/ramadan@main/asset/ns.min.js?v=20260221-1.2\" defer></script>",
