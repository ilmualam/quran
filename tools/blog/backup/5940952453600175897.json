dashed #d5ded8;\n        padding-top: 8px;\n        margin-top: 6px;\n    }\n    .ilmx-afy-btn {\n        font: inherit;\n        font-size: 0.82rem;\n        font-weight: 700;\n        border: 1px solid #bfe3c9;\n        background: #effaf2;\n        color: #0c3808;\n        border-radius: 8px;\n        padding: 6px 12px;\n        cursor: pointer;\n    }\n    .ilmx-afy-tw {\n        overflow-x: auto;\n        margin: 0 0 1rem;\n        border: 1px solid #e1e8e3;\n        border-radius: 12px;\n    }\n    .ilmx-afy table {\n        border-collapse: collapse;\n        width: 100%;\n        font-size: 0.9rem;\n        min-width: 520px;\n    }\n    .ilmx-afy th {\n        background: #0c3808;\n        color: #fff!important;\n        text-align: left;\n        padding: 9px 10px;\n        font-weight: 700;\n    }\n    .ilmx-afy td {\n        padding: 9px 10px;\n        border-top: 1px solid #e1e8e3;\n        vertical-align: top;\n    }\n    .ilmx-afy tr:nth-child(even) td {\n        background: #f8fbf9;\n    }\n    .ilmx-afy-box {\n        border-radius: 12px;\n        padding: 12px 16px;\n        margin: 0 0 1rem;\n        font-size: 0.95rem;\n    }\n    .ilmx-afy-box.amber {\n        background: #fff8e6;\n        border: 1px solid #f0d9a0;\n    }\n    .ilmx-afy-box.blue {\n        background: #eef5fd;\n        border: 1px solid #c7dcf5;\n    }\n    .ilmx-afy-calc {\n        border: 2px solid #1f7a3c;\n        border-radius: 14px;\n        padding: 16px;\n        margin: 0 0 1.2rem;\n        background: #f8fcf9;\n    }\n    .ilmx-afy-calc h3 {\n        margin-top: 0;\n    }\n    .ilmx-afy-grid {\n        display: grid;\n        gap: 10px;\n        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n        margin: 0 0 10px;\n    }\n    .ilmx-afy-grid label {\n        display: block;\n        font-weight: 700;\n        font-size: 0.85rem;\n        margin-bottom: 3px;\n    }\n    .ilmx-afy-grid input {\n        width: 100%;\n        height: 44px;\n        border: 1px solid #c8d6cc;\n        border-radius: 10px;\n        padding: 0 10px;\n        font: inherit;\n        background: #fff;\n    }\n    .ilmx-afy-out {\n        background: #0c3808;\n        color: #fff;\n        border-radius: 12px;\n        padding: 12px 14px;\n        font-size: 0.95rem;\n    }\n    .ilmx-afy-out strong {\n        color: #ffe27a;\n    }\n    .ilmx-afy-faq details {\n        border: 1px solid #e1e8e3;\n        border-radius: 12px;\n        margin: 0 0 8px;\n        background: #fff;\n    }\n    .ilmx-afy-faq summary {\n        cursor: pointer;\n        font-weight: 700;\n        padding: 12px 14px;\n        color: #0c3808;\n        list-style: none;\n    }\n    .ilmx-afy-faq summary::-webkit-details-marker {\n        display: none;\n    }\n    .ilmx-afy-faq summary::after {\n        content: \"\\002B\";\n      \tfont-size:1.5rem;\n        float: right;\n        font-weight: 800;\n        color: #1f7a3c;\n    }\n    .ilmx-afy-faq details[open] summary::after {\n        content: \"\\2212\";\n    }\n    .ilmx-afy-faq details > p {\n        padding: 0 14px 12px;\n        margin: 0;\n    }\n    .ilmx-afy-refs {\n        font-size: 0.85rem;\n        color: #38503f;\n    }\n    .ilmx-afy-cta {\n        display: block;\n        background: #effaf2;\n        border: 1px solid #bfe3c9;\n        border-radius: 12px;\n        padding: 12px 14px;\n        margin: 0 0 1rem;\n        text-decoration: none !important;\n        color: #0c3808 !important;\n        font-weight: 700;\n    }\n    .ilmx-afy-cta span {\n        display: block;\n        font-weight: 400;\n        font-size: 0.88rem;\n        color: #38503f;\n    }\n</style>\n<div class=\"ilmx-afy\">\n    <img\n        src=\"https://quran.ilmualam.com/assets/blog/doa-al-afiyah.webp\"\n        alt=\"Doa Al-Afiyah memohon keselamatan di dunia dan akhirat\"\n        width=\"1200\"\n        height=\"675\"\n        title=\"Doa Al-Afiyah: Bacaan Arab, Rumi, Maksud &amp; Kelebihan (Hadis Sahih)\"\n    />\n    <div class=\"ilmx-afy-hero\">\n        <div class=\"ilmx-afy-badges\">\n            <span class=\"ilmx-afy-badge\">Hadis Sahih</span><span class=\"ilmx-afy-badge\">Zikir Pagi &amp; Petang</span\n            ><span class=\"ilmx-afy-badge\">Arab · Rumi · Maksud</span\n            ><span class=\"ilmx-afy-badge\">Dikemas kini 2026</span>\n        </div>\n        <h2>Doa Al-Afiyah: Bacaan Penuh &amp; Kelebihannya</h2>\n        <p>\n            Doa memohon afiyah yang tidak pernah ditinggalkan Rasulullah SAW pada waktu pagi dan petang, dengan empat\n            lafaz daripada hadis dan cara mengamalkannya.\n        </p>\n    </div>\n    <p class=\"ilmx-afy-meta\">\n        ✍️ Disediakan oleh <strong>Pasukan Editorial The Ilmu Alam</strong> · Dikemas kini 15 November 2026 (asal 8\n        Julai 2020) · Rujukan: Sunan Abu Daud, Sunan At-Tirmizi, Sahih Muslim\n    </p>\n    <div class=\"ilmx-afy-answer\">\n        <p>\n            <strong>Jawapan ringkas:</strong> Doa Al-Afiyah ialah\n            <strong>“Allahumma inni as&#x27;alukal-&#x27;afwa wal-&#x27;afiyah fid-dunya wal-akhirah…”</strong>: memohon\n            keampunan dan keselamatan dalam agama, dunia, keluarga dan harta. Ibn Umar RA meriwayatkan Rasulullah SAW\n            <strong>tidak pernah meninggalkannya pada waktu pagi dan petang</strong> <em>(HR Abu Daud, no. 5074)</em>.\n            Baginda juga bersabda, tiada yang dikurniakan selepas keyakinan yang lebih baik daripada afiyah\n            <em>(HR At-Tirmizi, no. 3558)</em>.\n        </p>\n    </div>\n    <nav class=\"ilmx-afy-toc\" aria-label=\"Isi kandungan\">\n        <strong>Isi kandungan</strong>\n        <ol>\n            <li><a href=\"#ilmx-afy-bacaan\">Bacaan Doa Al-Afiyah (Pagi &amp; Petang)</a></li>\n            <li><a href=\"#ilmx-afy-maksud\">Apakah Maksud Afiyah?</a></li>\n            <li><a href=\"#ilmx-afy-lafaz\">4 Lafaz Doa Afiyah daripada Hadis</a></li>\n            <li><a href=\"#ilmx-afy-kelebihan\">Kelebihan Doa Al-Afiyah</a></li>\n            <li><a href=\"#ilmx-afy-silap\">Kesilapan Biasa ketika Mengamalkan Doa Afiyah</a></li>\n            <li><a href=\"#ilmx-afy-amal\">Cara Mengamalkan</a></li>\n            <li><a href=\"#ilmx-afy-faq\">Soalan lazim</a></li>\n        </ol>\n    </nav>\n    <h2 id=\"ilmx-afy-bacaan\">Bacaan Doa Al-Afiyah (Pagi &amp; Petang)</h2>\n    <div class=\"ilmx-afy-card\">\n        <h3>Doa memohon keampunan dan keselamatan</h3>\n        <p class=\"ilmx-afy-ar\" lang=\"ar\" dir=\"rtl\">\n            اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ فِي الدُّنْيَا وَالْآخِرَةِ، اللَّهُمَّ إِنِّي\n            أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ فِي دِينِي وَدُنْيَايَ وَأَهْلِي وَمَالِي، اللَّهُمَّ اسْتُرْ عَوْرَاتِي\n            وَآمِنْ رَوْعَاتِي، اللَّهُمَّ احْفَظْنِي مِنْ بَيْنِ يَدَيَّ وَمِنْ خَلْفِي وَعَنْ يَمِينِي وَعَنْ شِمَالِي\n            وَمِنْ فَوْقِي، وَأَعُوذُ بِعَظَمَتِكَ أَنْ أُغْتَالَ مِنْ تَحْتِي\n        </p>\n        <p class=\"ilmx-afy-ru\">\n            Allahumma inni as&#x27;alukal-&#x27;afwa wal-&#x27;afiyah fid-dunya wal-akhirah. Allahumma inni\n            as&#x27;alukal-&#x27;afwa wal-&#x27;afiyah fi dini wa dunyaya wa ahli wa mali. Allahummastur &#x27;aurati wa\n            amin rau&#x27;ati. Allahummahfazni min baini yadayya wa min khalfi wa &#x27;an yamini wa &#x27;an syimali wa\n            min fauqi, wa a&#x27;uzu bi&#x27;azamatika an ughtala min tahti\n        </p>\n        <p class=\"ilmx-afy-mn\">\n            <strong>Maksud:</strong> Ya Allah, aku memohon keampunan dan keselamatan di dunia dan akhirat. Ya Allah, aku\n            memohon keampunan dan keselamatan dalam agamaku, duniaku, keluargaku dan hartaku. Ya Allah, tutuplah aibku\n            dan tenangkanlah ketakutanku. Ya Allah, peliharalah aku dari hadapan, belakang, kanan, kiri dan atasku, dan\n            aku berlindung dengan keagungan-Mu daripada dibinasakan dari bawahku.\n        </p>\n        <p class=\"ilmx-afy-ru\" style=\"font-style: normal\">\n            Dibaca sekali pada waktu pagi dan sekali pada waktu petang.\n        </p>\n        <div class=\"ilmx-afy-src\">\n            <span>HR Abu Daud, no. 5074; Ibn Majah, no. 3871 (sahih)</span\n            ><button class=\"ilmx-afy-btn\" type=\"button\" data-copy>Salin</button>\n        </div>\n    </div>\n    <h2 id=\"ilmx-afy-maksud\">Apakah Maksud Afiyah?</h2>\n\n<p>Perkataan <strong>al-'afiyah (العافية)</strong> membawa maksud keselamatan, kesejahteraan dan perlindungan daripada perkara yang memudaratkan.</p>\n\n<p>Afiyah bukan sekadar kesihatan tubuh badan. Ia merangkumi permohonan agar Allah memelihara kehidupan seseorang daripada keburukan dalam urusan agama, dunia, keluarga, harta dan akhirat.</p>\n\n<p>Dalam doa ini, terdapat dua permintaan utama iaitu <strong>al-'afwu</strong> dan <strong>al-'afiyah</strong>.</p>\n\n  <div id=\"ilmx-afy-silap\">Dua Permintaan Utama Al-'Afwu &amp; Al-'Afiyah</div>\n<div class=\"ilmx-afy-tw\">\n<table>\n<thead>\n<tr><th>Lafaz doa</th><th>Maksud permohonan</th></tr>\n</thead>\n<tbody>\n<tr><td>Al-'afwa</td><td>Memohon keampunan dan kemaafan daripada Allah.</td></tr>\n<tr><td>Al-'afiyah</td><td>Memohon keselamatan dan perlindungan daripada keburukan.</td></tr>\n<tr><td>Fi dini</td><td>Keselamatan dalam urusan agama.</td></tr>\n<tr><td>Wa dunyaya</td><td>Kebaikan dan kesejahteraan kehidupan dunia.</td></tr>\n<tr><td>Wa ahli</td><td>Perlindungan untuk keluarga.</td></tr>\n<tr><td>Wa mali</td><td>Perlindungan terhadap harta.</td></tr>\n<tr><td>Ustur 'aurati</td><td>Memohon agar aib dan kekurangan ditutup.</td></tr>\n<tr><td>Amin rau'ati</td><td>Memohon ketenangan daripada ketakutan.</td></tr>\n</tbody>\n</table>\n</div>\n\n<p>Oleh sebab itu, doa afiyah sangat menyeluruh. Kita bukan sekadar meminta tubuh yang sihat, tetapi turut memohon agar kehidupan dan keimanan sentiasa berada dalam perlindungan Allah SWT.</p>\n\n    <p>Ungkapan “sihat wal afiat” yang biasa kita ucapkan berasal daripada makna ini.</p>\n    <h2 id=\"ilmx-afy-lafaz\">4 Lafaz Doa Afiyah daripada Hadis</h2>\n    <div class=\"ilmx-afy-card\">\n        <h3>1. Doa ringkas memohon afiyah</h3>\n        <p class=\"ilmx-afy-ar\" lang=\"ar\" dir=\"rtl\">اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَافِيَةَ</p>\n        <p class=\"ilmx-afy-ru\">Allahumma inni as&#x27;alukal-&#x27;afiyah.</p>\n        <p class=\"ilmx-afy-mn\"><strong>Maksud:</strong> Ya Allah, sesungguhnya aku memohon afiyah kepada-Mu.</p>\n        <div class=\"ilmx-afy-src\">\n            <span\n                >HR At-Tirmizi, no. 3514: Nabi SAW mengajar bapa saudaranya Al-Abbas: “Mintalah afiyah kepada\n                Allah.”</span\n            ><button class=\"ilmx-afy-btn\" type=\"button\" data-copy>Salin</button>\n        </div>\n    </div>\n    <div class=\"ilmx-afy-card\">\n        <h3>2. Afiyah tubuh, pendengaran dan penglihatan (3×)</h3>\n        <p class=\"ilmx-afy-ar\" lang=\"ar\" dir=\"rtl\">\n            اللَّهُمَّ عَافِنِي فِي بَدَنِي، اللَّهُمَّ عَافِنِي فِي سَمْعِي، اللَّهُمَّ عَافِنِي فِي بَصَرِي، لَا\n            إِلَهَ إِلَّا أَنْتَ\n        </p>\n        <p class=\"ilmx-afy-ru\">\n            Allahumma &#x27;afini fi badani, Allahumma &#x27;afini fi sam&#x27;i, Allahumma &#x27;afini fi basari, la\n            ilaha illa anta\n        </p>\n        <p class=\"ilmx-afy-mn\">\n            <strong>Maksud:</strong> Ya Allah, sihatkanlah tubuhku. Ya Allah, sihatkanlah pendengaranku. Ya Allah,\n            sihatkanlah penglihatanku. Tiada tuhan melainkan Engkau.\n        </p>\n        <p class=\"ilmx-afy-ru\" style=\"font-style: normal\">Dibaca tiga kali pada waktu pagi dan petang.</p>\n        <div class=\"ilmx-afy-src\">\n            <span>HR Abu Daud, no. 5090 (hasan)</span\n            ><button class=\"ilmx-afy-btn\" type=\"button\" data-copy>Salin</button>\n        </div>\n    </div>\n    <div class=\"ilmx-afy-card\">\n        <h3>3. Doa Lailatul Qadar (memohon kemaafan)</h3>\n        <p class=\"ilmx-afy-ar\" lang=\"ar\" dir=\"rtl\">اللَّهُمَّ إِنَّكَ عَفُوٌّ تُحِبُّ الْعَفْوَ فَاعْفُ عَنِّي</p>\n        <p class=\"ilmx-afy-ru\">Allahumma innaka &#x27;afuwwun tuhibbul-&#x27;afwa fa&#x27;fu &#x27;anni.</p>\n        <p class=\"ilmx-afy-mn\">\n            <strong>Maksud:</strong> Ya Allah, sesungguhnya Engkau Maha Pemaaf, Engkau suka memaafkan, maka maafkanlah\n            aku.\n        </p>\n        <p class=\"ilmx-afy-ru\" style=\"font-style: normal\">\n            Tambahan “karim” selepas 'afuwwun yang popular tidak terdapat dalam riwayat yang sahih.\n        </p>\n        <div class=\"ilmx-afy-src\">\n            <span>HR At-Tirmizi, no. 3513 (sahih)</span\n            ><button class=\"ilmx-afy-btn\" type=\"button\" data-copy>Salin</button>\n        </div>\n    </div>\n    <div class=\"ilmx-afy-card\">\n        <h3>4. Doa lengkap yang diajar kepada orang yang baru memeluk Islam</h3>\n        <p class=\"ilmx-afy-ar\" lang=\"ar\" dir=\"rtl\">\n            اللَّهُمَّ اغْفِرْ لِي وَارْحَمْنِي وَاهْدِنِي وَعَافِنِي وَارْزُقْنِي\n        </p>\n        <p class=\"ilmx-afy-ru\">Allahummaghfir li warhamni wahdini wa &#x27;afini warzuqni.</p>\n        <p class=\"ilmx-afy-mn\">\n            <strong>Maksud:</strong> Ya Allah, ampunilah aku, rahmatilah aku, berilah aku petunjuk, kurniakanlah aku\n            afiyah dan berilah aku rezeki.\n        </p>\n        <div class=\"ilmx-afy-src\">\n            <span>HR Muslim, no. 2697</span><button class=\"ilmx-afy-btn\" type=\"button\" data-copy>Salin</button>\n        </div>\n    </div>\n    <h2 id=\"ilmx-afy-kelebihan\">Kelebihan Doa Al-Afiyah</h2>\n    <ul>\n        <li>Amalan tetap Rasulullah SAW setiap pagi dan petang <em>(HR Abu Daud, no. 5074)</em>.</li>\n        <li>\n            “Mohonlah kepada Allah keampunan dan afiyah, kerana tiada seorang pun dikurniakan sesuatu selepas keyakinan\n            yang lebih baik daripada afiyah.” <em>(HR At-Tirmizi, no. 3558)</em>\n        </li>\n        <li>\n            Ketika Al-Abbas meminta doa yang patut dimohon, Nabi SAW berulang kali menjawab: mintalah afiyah, di dunia\n            dan akhirat <em>(HR At-Tirmizi, no. 3514)</em>.\n        </li>\n        <li>Satu doa merangkumi perlindungan agama, kesihatan, keluarga, harta dan keselamatan diri.</li>\n    </ul>\n    <h2 id=\"ilmx-afy-silap\">Kesilapan Biasa ketika Mengamalkan Doa Afiyah</h2>\n    <div class=\"ilmx-afy-tw\">\n        <table>\n            <thead>\n                <tr>\n                    <th>Kesilapan</th>\n                    <th>Yang betul</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>Menganggap afiyah hanya bermaksud sihat tubuh badan</td>\n                    <td>Afiyah merangkumi keselamatan agama, dunia, keluarga dan harta, serta keampunan di akhirat</td>\n                </tr>\n                <tr>\n                    <td>Menambah “karim” dalam doa Lailatul Qadar dan menyangkanya lafaz hadis</td>\n                    <td>Lafaz sahih: Allahumma innaka 'afuwwun tuhibbul-'afwa fa'fu 'anni (HR At-Tirmizi, no. 3513)</td>\n                </tr>\n                <tr>\n                    <td>Hanya membaca ketika sakit</td>\n                    <td>Rasulullah SAW membacanya setiap pagi dan petang ketika sihat (HR Abu Daud, no. 5074)</td>\n                </tr>\n                <tr>\n                    <td>Berdoa tanpa memahami maksud</td>\n                    <td>Fahami setiap bahagian: agama, dunia, keluarga, harta dan perlindungan enam arah</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    <p>\n        Doa afiyah juga sesuai dibaca untuk ahli keluarga yang sakit atau sedang bermusafir, dengan menggantikan kata\n        ganti (contohnya “'afihi”, sihatkanlah dia) ketika berdoa dengan bahasa sendiri.\n    </p>\n    <h2 id=\"ilmx-afy-amal\">Cara Mengamalkan</h2>\n    <ol>\n        <li>Baca selepas solat Subuh (zikir pagi) dan selepas Asar atau Maghrib (zikir petang).</li>\n        <li>Fahami maksudnya dan hadirkan hajat: kesihatan keluarga, keselamatan perjalanan, keberkatan rezeki.</li>\n        <li>Gabungkan dengan zikir pagi dan petang yang lain dan istighfar.</li>\n    </ol>\n    <p>\n        Gunakan <a href=\"https://quran.ilmualam.com/zikir-pagi-petang/\">kaunter Zikir Pagi &amp; Petang</a> untuk\n        menanda bacaan harian anda; doa ini termasuk dalam senarai.\n    </p>\n    <h2 id=\"ilmx-afy-faq\">Soalan Lazim</h2>\n    <div class=\"ilmx-afy-faq\">\n        <details>\n            <summary>Apakah doa Al-Afiyah?</summary>\n            <p>\n                Allahumma inni as&#x27;alukal-&#x27;afwa wal-&#x27;afiyah fid-dunya wal-akhirah… (HR Abu Daud 5074):\n                memohon keampunan dan keselamatan dalam agama, dunia, keluarga dan harta, serta perlindungan dari semua\n                arah.\n            </p>\n        </details>\n        <details>\n            <summary>Bilakah doa Al-Afiyah dibaca?</summary>\n            <p>\n                Pada waktu pagi dan petang. Rasulullah SAW tidak pernah meninggalkannya pada kedua-dua waktu itu (HR Abu\n                Daud 5074).\n            </p>\n        </details>\n        <details>\n            <summary>Apakah maksud afiyah?</summary>\n            <p>\n                Dipelihara oleh Allah daripada segala keburukan, sama ada penyakit, musibah, fitnah atau dosa, di dunia\n                dan akhirat. Ia lebih luas daripada kesihatan tubuh.\n            </p>\n        </details>\n        <details>\n            <summary>Adakah lafaz “Allahumma innaka &#x27;afuwwun karim” sahih?</summary>\n            <p>\n                Riwayat sahih dalam At-Tirmizi (3513) tanpa perkataan “karim”. Lafaz yang sahih: Allahumma innaka\n                &#x27;afuwwun tuhibbul-&#x27;afwa fa&#x27;fu &#x27;anni.\n            </p>\n        </details>\n    </div>\n    <h2 id=\"ilmx-afy-rujukan\">Rujukan</h2>\n    <ol class=\"ilmx-afy-refs\">\n        <li>Sunan Abu Daud, no. 5074, 5090.</li>\n        <li>Sunan At-Tirmizi, no. 3513, 3514, 3558.</li>\n        <li>Sunan Ibn Majah, no. 3871.</li>\n        <li>Sahih Muslim, no. 2697.</li>\n        <li>Imam An-Nawawi, Al-Azkar, bab zikir pagi dan petang.</li>\n    </ol>\n    <div class=\"ilmx-afy-box blue\">\n        <strong>Nota:</strong> Rumi ialah alat bantu sebutan; rujuk guru untuk sebutan Arab yang tepat.\n    </div>\n    <h2 id=\"ilmx-afy-lagi\">Baca &amp; Guna Juga</h2>\n    <a class=\"ilmx-afy-cta\" href=\"https://quran.ilmualam.com/zikir-pagi-petang/\"\n        >Zikir Pagi &amp; Petang (dengan Kaunter)<span>Senarai lengkap dengan rujukan hadis</span></a\n    ><a class=\"ilmx-afy-cta\" href=\"https://quran.ilmualam.com/doa-harian/\"\n        >Himpunan Doa Harian<span>Doa daripada hadis dan Al-Quran dengan rujukan</span></a\n    ><a class=\"ilmx-afy-cta\" href=\"https://quran.ilmualam.com/doa-orang-sakit/\"\n        >Doa Orang Sakit<span>Doa ketika sakit dan menziarahi pesakit</span></a\n    >\n    <script type=\"application/ld+json\">\n        {\n            \"@context\": \"https://schema.org\",\n            \"@graph\": [\n                {\n                    \"@type\": \"Article\",\n                    \"headline\": \"Doa Al-Afiyah: Bacaan Arab, Rumi, Maksud & Kelebihan (Hadis Sahih)\",\n                    \"description\": \"Doa Al-Afiyah yang diamalkan Rasulullah SAW pagi dan petang, dengan tulisan Arab, Rumi, maksud, maksud afiyah, empat lafaz doa afiyah dan kelebihannya.\",\n                    \"image\": [\"https://quran.ilmualam.com/assets/blog/doa-al-afiyah.webp\"],\n                    \"datePublished\": \"2020-07-08\",\n                    \"dateModified\": \"2026-11-15\",\n                    \"inLanguage\": \"ms-MY\",\n                    \"mainEntityOfPage\": \"https://www.ilmualam.com/2020/07/doa-al-afiyah-ringkas-tapi-power.html\",\n                    \"author\": { \"@type\": \"Organization\", \"name\": \"The Ilmu Alam\", \"url\": \"https://www.ilmualam.com/\" },\n                    \"publisher\": {\n                        \"@type\": \"Organization\",\n                        \"name\": \"The Ilmu Alam\",\n                        \"url\": \"https://www.ilmualam.com/\"\n                    },\n                    \"about\": [\n                        { \"@type\": \"Thing\", \"name\": \"Doa Al-Afiyah\" },\n                        { \"@type\": \"Thing\", \"name\": \"Zikir pagi petang\" }\n                    ]\n                },\n                {\n                    \"@type\": \"FAQPage\",\n                    \"mainEntity\": [\n                        {\n                            \"@type\": \"Question\",\n                            \"name\": \"Apakah doa Al-Afiyah?\",\n                            \"acceptedAnswer\": {\n                                \"@type\": \"Answer\",\n                                \"text\": \"Allahumma inni as'alukal-'afwa wal-'afiyah fid-dunya wal-akhirah… (HR Abu Daud 5074): memohon keampunan dan keselamatan dalam agama, dunia, keluarga dan harta, serta perlindungan dari semua arah.\"\n                            }\n                        },\n                        {\n                            \"@type\": \"Question\",\n                            \"name\": \"Bilakah doa Al-Afiyah dibaca?\",\n                            \"acceptedAnswer\": {\n                                \"@type\": \"Answer\",\n                                \"text\": \"Pada waktu pagi dan petang. Rasulullah SAW tidak pernah meninggalkannya pada kedua-dua waktu itu (HR Abu Daud 5074).\"\n                            }\n                        },\n                        {\n                            \"@type\": \"Question\",\n                            \"name\": \"Apakah maksud afiyah?\",\n                            \"acceptedAnswer\": {\n                                \"@type\": \"Answer\",\n                                \"text\": \"Dipelihara oleh Allah daripada segala keburukan, sama ada penyakit, musibah, fitnah atau dosa, di dunia dan akhirat. Ia lebih luas daripada kesihatan tubuh.\"\n                            }\n                        },\n                        {\n                            \"@type\": \"Question\",\n                            \"name\": \"Adakah lafaz “Allahumma innaka 'afuwwun karim” sahih?\",\n                            \"acceptedAnswer\": {\n                                \"@type\": \"Answer\",\n                                \"text\": \"Riwayat sahih dalam At-Tirmizi (3513) tanpa perkataan “karim”. Lafaz yang sahih: Allahumma innaka 'afuwwun tuhibbul-'afwa fa'fu 'anni.\"\n                            }\n                        }\n                    ]\n                },\n                {\n                    \"@type\": \"BreadcrumbList\",\n                    \"itemListElement\": [\n                        {\n                            \"@type\": \"ListItem\",\n                            \"position\": 1,\n                            \"name\": \"Ilmu Alam\",\n                            \"item\": \"https://www.ilmualam.com/\"\n                        },\n                        {\n                            \"@type\": \"ListItem\",\n                            \"position\": 2,\n                            \"name\": \"Doa\",\n                            \"item\": \"https://www.ilmualam.com/search/label/Doa\"\n                        },\n                        {\n                            \"@type\": \"ListItem\",\n                            \"position\": 3,\n                            \"name\": \"Doa Al-Afiyah: Bacaan Arab, Rumi, Maksud & Kelebihan (Hadis Sahih)\",\n                            \"item\": \"https://www.ilmualam.com/2020/07/doa-al-afiyah-ringkas-tapi-power.html\"\n                        }\n                    ]\n                }\n            ]\n        }\n    </script>\n    <script>\n        (function () {\n            var w = document.querySelector(\".ilmx-afy\");\n            if (!w) return;\n            w.addEventListener(\"click\", function (ev) {\n                var b = ev.target.closest(\"[data-copy]\");\n                if (!b) return;\n                var c = b.closest(\".ilmx-afy-card\");\n                var t =\n                    [].map\n                        .call(\n                            c.querySelectorAll(\"h3,.ilmx-afy-ar,.ilmx-afy-ru,.ilmx-afy-mn,.ilmx-afy-src span\"),\n                            function (n) {\n                                return n.innerText.trim();\n                            }\n                        )\n                        .join(\"\\n\\n\") +\n                    \"\\n\\n\" +\n                    location.href.split(\"#\")[0];\n                navigator.clipboard &&\n                    navigator.clipboard.writeText(t).then(function () {\n                        b.textContent = \"✓ Disalin\";\n                        setTimeout(function () {\n                            b.textContent = \"Salin\";\n                        }, 1600);\n                    });\n            });\n        })();\n    </script>\n</div>\n",
