tems:center; justify-content:center; min-width:28px; height:28px; background:#249749; color:#fff; border-radius:50%; font-size:13px; font-weight:800; flex-shrink:0;}\n.ilmx-ast-callout {border-radius:12px; padding:16px 18px; margin:18px 0; display:flex; gap:13px; align-items:flex-start; font-size:15px; line-height:1.65}\n.c-info {background:#eaf4ff; border:1px solid #90caff; border-left:4px solid #2196f3; color:#0d3a6e}\n.c-penting {background:#fff0f0; border:1px solid #ffb3b3; border-left:4px solid #e53935; color:#5a1a1a}\n.c-green {background:#f0faf2; border:1px solid #a7d7b3; border-left:4px solid #249749; color:#0c3808}\n.ilmx-ast-callout .ci {font-size:22px; flex-shrink:0; margin-top:1px}\n.ilmx-ast-callout p {margin:0; color:inherit; font-size:15px}\n.ilmx-ast-tanda-grid {display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:14px; margin:20px 0}\n.ilmx-ast-tanda-card {background:#fff; border:1px solid #d4edda; border-radius:12px; padding:18px 16px; box-shadow:0 2px 10px rgba(36,151,73,.07); border-left:4px solid #249749}\n.ilmx-ast-tanda-card.amber {border-left-color:#f59e0b}\n.ilmx-ast-tanda-card .icon {font-size:26px; margin-bottom:8px; display:block}\n.ilmx-ast-tanda-card h3 {font-size:14px; font-weight:700; color:#0c3808; margin:0 0 6px}\n.ilmx-ast-tanda-card p {font-size:13px; color:#555; margin:0; line-height:1.55}\n.ilmx-ast-faq {margin:26px 0}\n.ilmx-ast-faq-item {border:1px solid #d4edda; border-radius:10px; margin-bottom:8px; overflow:hidden; background:#fff}\n.ilmx-ast-faq-q {width:100%; min-height:50px; background:#f6fcf7; border:0; text-align:left; padding:14px 16px; font-size:15px; font-weight:700; color:#0c3808; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:10px; touch-action:manipulation; line-height:1.5; font-family:inherit;}\n.ilmx-ast-faq-q .arr {font-size:16px; flex-shrink:0; transition:transform .2s; color:#249749}\n.ilmx-ast-faq-q[aria-expanded=\"true\"] .arr {transform:rotate(180deg)}\n.ilmx-ast-faq-a {padding:0 16px 14px; font-size:15px; color:#444; line-height:1.7; background:#fff}\n.ilmx-ast-faq-a p {margin:12px 0 0}\n.ilmx-ast-cta-green {background:linear-gradient(135deg,#0c3808,#249749); border-radius:14px; padding:26px 20px; margin:28px 0; text-align:center}\n.ilmx-ast-cta-green h3 {font-size:17px; font-weight:800; color:#fff; margin:0 0 7px}\n.ilmx-ast-cta-green p {color:rgba(255,255,255,.86); font-size:14px; margin:0 0 14px}\n.ilmx-ast-cta-btn {display:inline-flex; align-items:center; justify-content:center; min-height:44px; background:#fff; color:#0c3808; font-size:14px; font-weight:800; padding:10px 22px; border-radius:8px; text-decoration:none; touch-action:manipulation}\n.ilmx-ast-hr {border:0; border-top:2px solid #e8f5ea; margin:30px 0}\n.ilmx-ast-cluster-grid {display:grid; grid-template-columns:repeat(auto-fit,minmax(195px,1fr)); gap:10px; margin:14px 0}\n.ilmx-ast-cluster-item {background:#f6fcf7; border:1px solid #d4edda; border-radius:10px; padding:13px 15px; text-decoration:none; color:#0c3808; font-size:14px; font-weight:600; display:flex; align-items:center; gap:8px; transition:background .15s, border-color .15s}\n.ilmx-ast-wrap button:focus-visible, .ilmx-ast-wrap a:focus-visible {outline:3px solid rgba(36,151,73,.35); outline-offset:3px;}\n\n@media(hover:hover) {\n.ilmx-ast-sebab-btn:hover {border-color:#249749; transform:translateY(-1px)}\n.ilmx-ast-cluster-item:hover {background:#e6f7eb; border-color:#249749}\n}\n\n@media(max-width:640px) {\n.ilmx-ast-wrap {padding:10px!important}\n.ilmx-ast-hero {padding:30px 14px 26px}\n.ilmx-ast-sebab-wrap {padding:20px 12px}\n.ilmx-ast-zblock {padding:20px 14px}\n.ilmx-ast-zblock .za {font-weight:600; font-size:1.6rem;}\n.ilmx-btn-row {align-items:stretch}\n.ilmx-btn-wa, .ilmx-btn-copy {flex:1 1 140px}\n}\n\n@media(prefers-reduced-motion:reduce) {\n.ilmx-ast-wrap *, .ilmx-ast-wrap *::before, .ilmx-ast-wrap *::after {scroll-behavior:auto!important; animation:none!important; transition:none!important;}\n}\n</style>\n<div class=\"ilmx-ast-wrap\">\n\n  <section class=\"ilmx-ast-hero\" aria-labelledby=\"ilmxAstTitle\">\n    <span class=\"ilmx-ast-badge\">💚 Panduan Ibu Bapa</span>\n    <span class=\"ilmx-ast-hero-icon\" aria-hidden=\"true\">🌙</span>\n    <h2 id=\"ilmxAstTitle\">Doa Anak Susah Tidur &amp; Meragam Malam: Punca &amp; Cara Atasi</h2>\n    <span class=\"ilmx-ast-hero-sub\">Kenal pasti sebab dahulu, kemudian gabungkan ikhtiar fizikal, rutin tidur dan doa yang bersumber</span>\n    <div class=\"ilmx-ast-hero-pills\" aria-label=\"Sorotan panduan\">\n      <span class=\"ilmx-ast-hero-pill\">🔍 Kenal Sebab</span>\n      <span class=\"ilmx-ast-hero-pill\">🤲 Doa &amp; Ruqyah</span>\n      <span class=\"ilmx-ast-hero-pill\">📚 Al-Kafi #560</span>\n    </div>\n  </section>\n\n  <span class=\"ilmx-ast-update\">🗓️ Semakan kandungan: Oktober 2026 &nbsp;|&nbsp; 📚 Rujukan Mufti WP &amp; hadis sahih</span>\n\n  <div class=\"ilmx-ast-answer\" id=\"ilmxAstAnswer\">\n    <p>\n      Jika anak susah tidur atau meragam pada waktu malam, <strong>semak dahulu keperluan fizikal dan tanda sakit</strong> seperti lapar, lampin tidak selesa, suhu bilik, tumbuh gigi atau perubahan rutin. Pejabat Mufti Wilayah Persekutuan dalam Al-Kafi #560 turut menekankan supaya punca utama dikenal pasti terlebih dahulu. Sebagai ikhtiar rohani, ibu bapa boleh membaca Al-Fatihah, Ayat Kursi, Al-Ikhlas, Al-Falaq, An-Nas serta doa ruqyah yang bersumber daripada hadis.\n    </p>\n  </div>\n\n  <p>Jam sudah lewat malam tetapi anak masih sukar ditenangkan. Dalam keadaan begini, jangan terus membuat kesimpulan bahawa anak mengalami gangguan rohani. Bayi dan kanak-kanak boleh terjaga atau menangis kerana banyak sebab biasa seperti lapar, ketidakselesaan, tumbuh gigi, sakit atau perubahan rutin tidur. Pemeriksaan sebab yang nyata perlu didahulukan, kemudian doa dan ruqyah boleh diamalkan sebagai sebahagian daripada ikhtiar.</p>\n\n  <div class=\"ilmx-ast-toc\"><b>{getToc} $title={Isi Kandungan} $count={Boolean} $expanded={Boolean}</b></div>\n\n  <div class=\"ilmx-ast-fatwa\">\n    <span class=\"ilmx-ast-fatwa-label\">📜 Intipati Al-Kafi #560</span>\n    <p>Pejabat Mufti Wilayah Persekutuan menjelaskan bahawa tiada doa khusus yang ditetapkan semata-mata untuk menghentikan tangisan anak pada waktu malam. Mereka menyarankan supaya sebab utama dikenal pasti terlebih dahulu, sambil membenarkan doa umum dan bacaan ruqyah daripada al-Quran serta hadis.</p>\n    <span class=\"src\">Sumber: Pejabat Mufti Wilayah Persekutuan, Al-Kafi Li Al-Fatawi #560, 2 Mac 2017.</span>\n  </div>\n\n  <hr class=\"ilmx-ast-hr\">\n\n  <h2>Kenal Pasti Punca Anak Susah Tidur Dahulu</h2>\n\n  <p>Sebelum memilih bacaan atau tindakan, semak keadaan anak secara sistematik. Alat di bawah bukan alat diagnosis; ia hanya membantu menyusun pemeriksaan asas.</p>\n\n  <div class=\"ilmx-ast-sebab-wrap\" id=\"ilmx-ast-sebab\">\n    <div class=\"ilmx-ast-sebab-hd\">\n      <h3>🔍 Kenal Pasti Sebab Dahulu</h3>\n      <p>Pilih keadaan yang paling hampir dengan situasi anak anda.</p>\n    </div>\n\n    <span class=\"ilmx-ast-sebab-q\">Anak susah tidur atau menangis malam ini kerana...</span>\n\n    <div class=\"ilmx-ast-sebab-btns\" role=\"group\" aria-label=\"Pilihan punca anak susah tidur\">\n      <button type=\"button\" class=\"ilmx-ast-sebab-btn\" data-sebab=\"fizikal\" aria-pressed=\"false\">\n        <span class=\"emoji\" aria-hidden=\"true\">🍼</span>\n        <span class=\"txt\"><span class=\"txt-title\">Keperluan Fizikal</span><span class=\"txt-sub\">Lapar, lampin, pakaian atau suhu tidak selesa</span></span>\n      </button>\n\n      <button type=\"button\" class=\"ilmx-ast-sebab-btn\" data-sebab=\"sakit\" aria-pressed=\"false\">\n        <span class=\"emoji\" aria-hidden=\"true\">🤒</span>\n        <span class=\"txt\"><span class=\"txt-title\">Kelihatan Tidak Sihat</span><span class=\"txt-sub\">Demam, muntah, batuk, lesu atau simptom lain</span></span>\n      </button>\n\n      <button type=\"button\" class=\"ilmx-ast-sebab-btn\" data-sebab=\"rutin\" aria-pressed=\"false\">\n        <span class=\"emoji\" aria-hidden=\"true\">🔄</span>\n        <span class=\"txt\"><span class=\"txt-title\">Rutin Tidur Terganggu</span><span class=\"txt-sub\">Tempat baru, jadual berubah atau tidur siang terlalu lewat</span></span>\n      </button>\n\n      <button type=\"button\" class=\"ilmx-ast-sebab-btn\" data-sebab=\"rohani\" aria-pressed=\"false\">\n        <span class=\"emoji\" aria-hidden=\"true\">🤲</span>\n        <span class=\"txt\"><span class=\"txt-title\">Sudah Disemak Tetapi Masih Resah</span><span class=\"txt-sub\">Teruskan pemantauan dan amalkan doa atau ruqyah sebagai ikhtiar</span></span>\n      </button>\n    </div>\n\n    <div id=\"result-fizikal\" class=\"ilmx-ast-sebab-result\" aria-live=\"polite\" hidden>\n      <h4>🍼 Tindakan: Semak Keperluan Fizikal</h4>\n      <p>Periksa perkara asas dahulu:</p>\n      <ul>\n        <li>Pastikan anak sudah diberi makan atau susu mengikut keperluannya.</li>\n        <li>Tukar lampin jika basah atau kotor.</li>\n        <li>Pastikan pakaian dan suhu bilik selesa serta tidak terlalu panas.</li>\n        <li>Perhatikan gusi jika anak sedang melalui fasa tumbuh gigi.</li>\n        <li>Tenangkan anak dengan dukungan, sentuhan lembut dan suasana yang redup.</li>\n      </ul>\n      <p>Selepas keperluan asas dipenuhi, teruskan rutin tidur yang konsisten dan bacaan zikir atau doa yang biasa diamalkan.</p>\n    </div>\n\n    <div id=\"result-sakit\" class=\"ilmx-ast-sebab-result\" aria-live=\"polite\" hidden>\n      <h4>🤒 Tindakan: Utamakan Penilaian Kesihatan</h4>\n      <p>Jika anak kelihatan sakit atau tingkah lakunya berbeza daripada biasa, dapatkan nasihat perubatan. Doa dan ruqyah boleh diamalkan sebagai pelengkap, tetapi tidak menggantikan pemeriksaan atau rawatan.</p>\n      <ul>\n        <li>Dapatkan rawatan segera jika anak kelihatan sangat lemah, sukar bernafas, mengalami sawan atau keadaan merosot dengan cepat.</li>\n        <li>Dapatkan nasihat doktor jika demam, muntah, kurang minum, tangisan luar biasa atau simptom lain berterusan.</li>\n        <li>Teruskan memantau pengambilan cecair, pernafasan dan tahap respons anak.</li>\n      </ul>\n    </div>\n\n    <div id=\"result-rutin\" class=\"ilmx-ast-sebab-result\" aria-live=\"polite\" hidden>\n      <h4>🔄 Tindakan: Stabilkan Rutin Tidur</h4>\n      <p>Rutin yang tenang dan boleh dijangka membantu ramai kanak-kanak bersedia untuk tidur.</p>\n      <ul>\n        <li>Kekalkan waktu tidur dan bangun yang hampir sama setiap hari.</li>\n        <li>Redupkan lampu dan kurangkan rangsangan sebelum tidur.</li>\n        <li>Untuk kanak-kanak lebih besar, elakkan skrin menjelang waktu tidur.</li>\n        <li>Gunakan urutan rutin yang sama seperti mandi, pakaian tidur, doa, cerita ringkas dan tidur.</li>\n      </ul>\n    </div>\n\n    <div id=\"result-rohani\" class=\"ilmx-ast-sebab-result\" aria-live=\"polite\" hidden>\n      <h4>🤲 Tindakan: Doa &amp; Ruqyah Sebagai Ikhtiar</h4>\n      <p>Selepas sebab fizikal dan kesihatan dinilai, ibu bapa boleh meneruskan doa dan ruqyah yang dibenarkan syarak tanpa membuat diagnosis sendiri tentang gangguan rohani.</p>\n      <ul>\n        <li>Baca Surah Al-Fatihah.</li>\n        <li>Baca Ayat Kursi.</li>\n        <li>Baca Al-Ikhlas, Al-Falaq dan An-Nas.</li>\n        <li>Baca doa ruqyah <em>Bismillahi arqik</em>.</li>\n        <li>Baca doa perlindungan yang Nabi SAW bacakan untuk Hasan dan Husain.</li>\n      </ul>\n    </div>\n  </div>\n\n  <h2>Doa &amp; Zikir untuk Anak Susah Tidur dan Meragam</h2>\n\n  <p class=\"ilmx-ast-source-note\">Keutamaan di bawah diberikan kepada bacaan yang mempunyai sumber yang lebih jelas. Doa popular “Allahumma gharatin-nujum...” tidak dimasukkan sebagai doa utama kerana status riwayatnya dipertikaikan.</p>\n\n  <h3>🛡️ 1. Doa Perlindungan untuk Anak - Sahih al-Bukhari</h3>\n  <div class=\"ilmx-ast-zblock gold\">\n    <span class=\"za\" lang=\"ar\" dir=\"rtl\">أُعِيذُكُمَا بِكَلِمَاتِ اللَّهِ التَّامَّةِ مِنْ كُلِّ شَيْطَانٍ وَهَامَّةٍ، وَمِنْ كُلِّ عَيْنٍ لَامَّةٍ</span>\n    <span class=\"zr\">U‘īdhukumā bi kalimātillāhit-tāmmati min kulli syaitānin wa hāmmah, wa min kulli ‘ainin lāmmah.</span>\n    <span class=\"zt\">Aku memohon perlindungan untuk kamu berdua dengan kalimah-kalimah Allah yang sempurna daripada setiap syaitan, segala yang memudaratkan dan setiap pandangan mata yang jahat.</span>\n    <span class=\"zhref\">📚 Sahih al-Bukhari 3371 - Nabi SAW membacakan doa perlindungan ini untuk Hasan dan Husain r.a.</span>\n    <div class=\"ilmx-btn-row\">\n      <button type=\"button\" class=\"ilmx-btn-copy\" data-copy=\"أُعِيذُكُمَا بِكَلِمَاتِ اللَّهِ التَّامَّةِ مِنْ كُلِّ شَيْطَانٍ وَهَامَّةٍ، وَمِنْ كُلِّ عَيْنٍ لَامَّةٍ\">📋 Salin</button>\n      <a class=\"ilmx-btn-wa\" href=\"https://wa.me/?text=Doa%20perlindungan%20anak%20-%20IlmuAlam.com\" target=\"_blank\" rel=\"noopener noreferrer\">📲 WhatsApp</a>\n    </div>\n  </div>\n\n  <h3>🤲 2. Ruqyah “Bismillahi Arqik”</h3>\n  <div class=\"ilmx-ast-zblock\">\n    <span class=\"za\" lang=\"ar\" dir=\"rtl\">بِاسْمِ اللَّهِ أَرْقِيكَ مِنْ كُلِّ شَيْءٍ يُؤْذِيكَ مِنْ شَرِّ كُلِّ نَفْسٍ أَوْ عَيْنِ حَاسِدٍ اللَّهُ يَشْفِيكَ بِاسْمِ اللَّهِ أَرْقِيكَ</span>\n    <span class=\"zr\">Bismillāhi arqīk, min kulli syai’in yu’dzīk, min syarri kulli nafsin aw ‘aini hāsid, Allāhu yasyfīk, bismillāhi arqīk.</span>\n    <span class=\"zt\">Dengan nama Allah aku meruqyahmu daripada segala sesuatu yang menyakitimu, daripada kejahatan setiap jiwa atau mata yang dengki. Semoga Allah menyembuhkanmu; dengan nama Allah aku meruqyahmu.</span>\n    <span class=\"zhref\">📚 Sahih Muslim 2186. Al-Kafi #560 turut menyenaraikan bacaan ruqyah ini sebagai antara ikhtiar untuk anak yang resah pada waktu malam.</span>\n    <div class=\"ilmx-btn-row\">\n      <button type=\"button\" class=\"ilmx-btn-copy\" data-copy=\"بِاسْمِ اللَّهِ أَرْقِيكَ مِنْ كُلِّ شَيْءٍ يُؤْذِيكَ مِنْ شَرِّ كُلِّ نَفْسٍ أَوْ عَيْنِ حَاسِدٍ اللَّهُ يَشْفِيكَ بِاسْمِ اللَّهِ أَرْقِيكَ\">📋 Salin</button>\n      <a class=\"ilmx-btn-wa\" href=\"https://wa.me/?text=Ruqyah%20Bismillahi%20Arqik%20-%20IlmuAlam.com\" target=\"_blank\" rel=\"noopener noreferrer\">📲 WhatsApp</a>\n    </div>\n  </div>\n\n  <h3>📖 3. Ayat Kursi</h3>\n  <div class=\"ilmx-ast-zblock\">\n    <span class=\"za\" lang=\"ar\" dir=\"rtl\">اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ</span>\n    <span class=\"zr\">Allāhu lā ilāha illā huwal-hayyul-qayyūm, lā ta’khudzuhū sinatun wa lā nawm...</span>\n    <span class=\"zt\">Allah, tiada Tuhan melainkan Dia, Yang Maha Hidup lagi Maha Berdiri Sendiri. Dia tidak mengantuk dan tidak tidur...</span>\n    <span class=\"zhref\">📚 Surah Al-Baqarah 2:255. Al-Kafi #560 menyenaraikan Ayat Kursi sebagai antara bacaan perlindungan. <a href=\"/2025/11/ayat-kursi-bacaan-rumi.html\">Baca Ayat Kursi penuh</a>.</span>\n  </div>\n\n  <h3>🌿 4. Al-Fatihah &amp; Tiga Qul</h3>\n  <div class=\"ilmx-ast-zblock\">\n    <span class=\"zt\">Baca Surah Al-Fatihah, kemudian Al-Ikhlas, Al-Falaq dan An-Nas. Ketiga-tiga surah perlindungan ini juga sesuai dijadikan sebahagian daripada rutin zikir sebelum tidur.</span>\n    <span class=\"zhref\">📚 Al-Kafi #560 menyenaraikan Al-Fatihah, Al-Ikhlas, Al-Falaq dan An-Nas sebagai antara bacaan yang boleh diamalkan.</span>\n  </div>\n\n  <h3>🌅 5. Bismillahilladzi - Zikir Pagi &amp; Petang</h3>\n  <div class=\"ilmx-ast-zblock\">\n    <span class=\"za\" lang=\"ar\" dir=\"rtl\">بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ</span>\n    <span class=\"zr\">Bismillāhilladzī lā yadhurru ma‘asmihī syai’un fil-ardhi wa lā fis-samā’, wa huwas-samī‘ul-‘alīm.</span>\n    <span class=\"zt\">Dengan nama Allah yang dengan nama-Nya tidak ada sesuatu pun di bumi dan di langit yang dapat memudaratkan, dan Dia Maha Mendengar lagi Maha Mengetahui.</span>\n    <span class=\"zhref\">📚 Diriwayatkan dalam Sunan Abi Dawud dan Jami‘ at-Tirmidhi sebagai zikir pagi dan petang. Jangan jadikan ia “ubat tidur khusus”; ia lebih tepat sebagai zikir perlindungan umum.</span>\n    <div class=\"ilmx-btn-row\">\n      <button type=\"button\" class=\"ilmx-btn-copy\" data-copy=\"بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ\">📋 Salin</button>\n    </div>\n  </div>\n\n  <h2>Cara Mengamalkan Doa dan Membina Rutin Malam</h2>\n\n  <ul class=\"ilmx-ast-steps\">\n    <li><span class=\"sn\">1</span><span><strong>Semak keperluan fizikal.</strong> Pastikan anak cukup makan, lampin bersih, pakaian selesa dan tidak menunjukkan tanda sakit.</span></li>\n    <li><span class=\"sn\">2</span><span><strong>Wujudkan suasana tenang.</strong> Redupkan lampu, kurangkan bunyi dan elakkan rangsangan berlebihan.</span></li>\n    <li><span class=\"sn\">3</span><span><strong>Baca Al-Fatihah, Ayat Kursi dan surah perlindungan.</strong> Bacalah dengan tenang tanpa menetapkan ritual tambahan yang tidak mempunyai sumber.</span></li>\n    <li><span class=\"sn\">4</span><span><strong>Baca doa perlindungan untuk anak.</strong> Doa yang Nabi SAW bacakan untuk Hasan dan Husain adalah antara pilihan yang mempunyai sumber sahih.</span></li>\n    <li><span class=\"sn\">5</span><span><strong>Baca ruqyah Bismillahi Arqik.</strong> Jadikan ia ikhtiar rohani, bukan pengganti pemeriksaan perubatan.</span></li>\n    <li><span class=\"sn\">6</span><span><strong>Kekalkan rutin yang boleh dijangka.</strong> Ulang urutan waktu tidur yang sama setiap malam mengikut umur dan keperluan anak.</span></li>\n  </ul>\n\n  <div class=\"ilmx-ast-callout c-info\">\n    <span class=\"ci\" aria-hidden=\"true\">💧</span>\n    <p><strong>Mengenai bacaan pada air:</strong> Al-Kafi #560 menyatakan ayat al-Quran dan doa boleh dibacakan pada air dan dipercikkan kepada orang yang sakit, dengan merujuk riwayat Abu Dawud tentang Thabit bin Qais. Jika diamalkan, anggap ia sebagai ikhtiar ruqyah dan bukan kaedah perubatan pengganti.</p>\n  </div>\n\n  <h2>Tanda yang Patut Diberi Perhatian</h2>\n\n  <div class=\"ilmx-ast-tanda-grid\">\n    <div class=\"ilmx-ast-tanda-card\">\n      <span class=\"icon\" aria-hidden=\"true\">✅</span>\n      <h3>Lebih Cenderung kepada Keperluan Biasa</h3>\n      <p>Anak reda selepas diberi susu, lampin ditukar, didukung atau rutin tidurnya dipulihkan; coraknya juga konsisten dengan waktu makan, tumbuh gigi atau perubahan jadual.</p>\n    </div>\n\n    <div class=\"ilmx-ast-tanda-card amber\">\n      <span class=\"icon\" aria-hidden=\"true\">⚠️</span>\n      <h3>Perlu Penilaian Kesihatan</h3>\n      <p>Tangisan luar biasa atau sukar dipujuk bersama demam, muntah, kurang minum, kesukaran bernafas, sangat lesu atau perubahan tingkah laku yang membimbangkan perlu dinilai oleh profesional kesihatan.</p>\n    </div>\n  </div>\n\n  <div class=\"ilmx-ast-callout c-penting\">\n    <span class=\"ci\" aria-hidden=\"true\">⚠️</span>\n    <p><strong>Penting:</strong> Corak menangis, terjaga pada waktu tertentu atau memandang sesuatu bukan bukti bahawa anak mengalami gangguan rohani. Jangan gunakan ciri tersebut sebagai diagnosis. Jika anda risau tentang keadaan anak, utamakan pemeriksaan kesihatan sambil meneruskan doa sebagai ikhtiar.</p>\n  </div>\n\n  <div class=\"ilmx-ast-callout c-green\">\n    <span class=\"ci\" aria-hidden=\"true\">🌙</span>\n    <p><strong>Rutin tidur juga penting:</strong> Untuk bayi dan kanak-kanak, rutin malam yang ringkas, tenang dan konsisten boleh membantu mereka bersedia untuk tidur. Untuk bayi kecil, ikuti juga panduan tidur selamat yang sesuai dengan umur.</p>\n  </div>\n\n  <div class=\"ilmx-ast-cta-green\">\n    <h3>💚 Bina Rutin Zikir Malam yang Konsisten</h3>\n    <p>Gabungkan rutin tidur yang tenang dengan zikir dan doa perlindungan yang mempunyai sumber.</p>\n    <a class=\"ilmx-ast-cta-btn\" href=\"/zikir-tidurkan-anak-amalan-sunnah\">🌙 Ke Panduan Zikir Tidurkan Anak</a>\n  </div>\n\n  <h2>Soalan Lazim (FAQ)</h2>\n\n  <div class=\"ilmx-ast-faq\">\n\n    <div class=\"ilmx-ast-faq-item\">\n      <button type=\"button\" class=\"ilmx-ast-faq-q\" aria-expanded=\"false\">\n        <span>🤔 Anak menangis pada waktu sama setiap malam, adakah tanda gangguan?</span><span class=\"arr\" aria-hidden=\"true\">▼</span>\n      </button>\n      <div class=\"ilmx-ast-faq-a\" hidden>\n        <p>Tidak semestinya. Corak pada waktu yang sama boleh berkaitan dengan lapar, kolik, tumbuh gigi, perubahan rutin atau kitaran tidur. Semak punca fizikal dan kesihatan dahulu. Doa dan ruqyah boleh diamalkan tanpa membuat kesimpulan bahawa puncanya ialah gangguan rohani.</p>\n      </div>\n    </div>\n\n    <div class=\"ilmx-ast-faq-item\">\n      <button type=\"button\" class=\"ilmx-ast-faq-q\" aria-expanded=\"false\">\n        <span>🤔 Berapa kali boleh baca ruqyah untuk anak?</span><span class=\"arr\" aria-hidden=\"true\">▼</span>\n      </button>\n      <div class=\"ilmx-ast-faq-a\" hidden>\n        <p>Bacaan ruqyah boleh diulang mengikut keperluan. Jika sesuatu riwayat menetapkan bilangan tertentu untuk bacaan tertentu, ikut bilangan tersebut pada konteksnya. Elakkan menetapkan nombor baru sebagai tuntutan agama tanpa dalil.</p>\n      </div>\n    </div>\n\n    <div class=\"ilmx-ast-faq-item\">\n      <button type=\"button\" class=\"ilmx-ast-faq-q\" aria-expanded=\"false\">\n        <span>🤔 Boleh baca doa atau ayat al-Quran pada air?</span><span class=\"arr\" aria-hidden=\"true\">▼</span>\n      </button>\n      <div class=\"ilmx-ast-faq-a\" hidden>\n        <p>Al-Kafi #560 menyatakan bahawa doa dan ayat al-Quran boleh dibacakan pada air dan dipercikkan kepada orang sakit, dengan merujuk riwayat berkaitan Thabit bin Qais. Ia ialah ikhtiar ruqyah, bukan pengganti rawatan perubatan.</p>\n      </div>\n    </div>\n\n    <div class=\"ilmx-ast-faq-item\">\n      <button type=\"button\" class=\"ilmx-ast-faq-q\" aria-expanded=\"false\">\n        <span>🤔 Bila perlu bawa anak berjumpa doktor?</span><span class=\"arr\" aria-hidden=\"true\">▼</span>\n      </button>\n      <div class=\"ilmx-ast-faq-a\" hidden>\n        <p>Dapatkan nasihat perubatan jika anak menunjukkan tanda sakit, kurang minum, muntah berterusan, demam, sangat lesu, sukar bernafas, tangisan yang sangat luar biasa atau keadaan yang semakin merosot. Untuk keadaan kecemasan, dapatkan rawatan segera.</p>\n      </div>\n    </div>\n\n    <div class=\"ilmx-ast-faq-item\">\n      <button type=\"button\" class=\"ilmx-ast-faq-q\" aria-expanded=\"false\">\n        <span>🤔 Bolehkah ibu yang haid membaca doa atau ruqyah untuk anak?</span><span class=\"arr\" aria-hidden=\"true\">▼</span>\n      </button>\n      <div class=\"ilmx-ast-faq-a\" hidden>\n        <p>Ibu tetap boleh berdoa, berzikir dan membaca bacaan perlindungan yang dibenarkan menurut panduan fiqh yang dipegang. Untuk perincian hukum membaca ayat al-Quran ketika haid, rujuk pandangan autoriti agama atau mazhab yang anda ikuti kerana terdapat perincian dan khilaf pada isu tersebut.</p>\n      </div>\n    </div>\n\n    <div class=\"ilmx-ast-faq-item\">\n      <button type=\"button\" class=\"ilmx-ast-faq-q\" aria-expanded=\"false\">\n        <span>🤔 Bapa juga boleh membaca doa perlindungan untuk anak?</span><span class=\"arr\" aria-hidden=\"true\">▼</span>\n      </button>\n      <div class=\"ilmx-ast-faq-a\" hidden>\n        <p>Ya. Doa perlindungan bukan khusus untuk ibu. Malah terdapat hadis sahih bahawa Nabi SAW membacakan doa perlindungan untuk cucu baginda, Hasan dan Husain r.a.</p>\n      </div>\n    </div>\n\n  </div>\n\n  <hr class=\"ilmx-ast-hr\">\n\n  <h2>📚 Artikel Berkaitan - Panduan Keluarga Islam</h2>\n  <div class=\"ilmx-ast-cluster-grid\">\n    <a href=\"/zikir-tidurkan-anak-amalan-sunnah\" class=\"ilmx-ast-cluster-item\">🌙 Zikir Tidurkan Anak Lengkap</a>\n    <a href=\"/doa-anak-mimpi-buruk\" class=\"ilmx-ast-cluster-item\">😰 Doa Anak Mimpi Buruk</a>\n    <a href=\"/doa-untuk-anak\" class=\"ilmx-ast-cluster-item\">🤲 Doa untuk Anak Soleh Solehah</a>\n    <a href=\"/cara-ajar-anak-solat-awal\" class=\"ilmx-ast-cluster-item\">🕌 Cara Ajar Anak Solat Awal</a>\n    <a href=\"/ruqyah-anak-sakit-demam\" class=\"ilmx-ast-cluster-item\">🛡️ Ruqyah Anak Sakit</a>\n    <a href=\"/doa-keluarga-bahagia\" class=\"ilmx-ast-cluster-item\">💚 Doa Keluarga Bahagia</a>\n  </div>\n\n</div>\n\n\n\n<script>\n(function(){\n'use strict';\n\nvar wrap=document.querySelector('.ilmx-ast-wrap');\nif(!wrap)return;\n\nfunction copyText(btn,text){\n  function done(){\n    var old=btn.textContent;\n    btn.textContent='✅ Disalin!';\n    btn.classList.add('copied');\n    setTimeout(function(){\n      btn.textContent=old;\n      btn.classList.remove('copied');\n    },1800);\n  }\n  if(navigator.clipboard&&navigator.clipboard.writeText){\n    navigator.clipboard.writeText(text).then(done).catch(function(){fallback(text,done);});\n  }else{\n    fallback(text,done);\n  }\n}\n\nfunction fallback(text,cb){\n  var ta=document.createElement('textarea');\n  ta.value=text;\n  ta.setAttribute('readonly','');\n  ta.style.cssText='position:fixed;opacity:0;pointer-events:none';\n  document.body.appendChild(ta);\n  ta.select();\n  try{document.execCommand('copy');cb();}catch(e){}\n  document.body.removeChild(ta);\n}\n\nwrap.addEventListener('click',function(e){\n  var copyBtn=e.target.closest('.ilmx-btn-copy[data-copy]');\n  if(copyBtn){\n    copyText(copyBtn,copyBtn.getAttribute('data-copy'));\n    return;\n  }\n\n  var sebabBtn=e.target.closest('.ilmx-ast-sebab-btn[data-sebab]');\n  if(sebabBtn){\n    var id=sebabBtn.getAttribute('data-sebab');\n\n    wrap.querySelectorAll('.ilmx-ast-sebab-btn').forEach(function(btn){\n      var active=btn===sebabBtn;\n      btn.classList.toggle('active',active);\n      btn.setAttribute('aria-pressed',active?'true':'false');\n    });\n\n    wrap.querySelectorAll('.ilmx-ast-sebab-result').forEach(function(result){\n      result.hidden=true;\n    });\n\n    var target=wrap.querySelector('#result-'+id);\n    if(target)target.hidden=false;\n    return;\n  }\n\n  var faqBtn=e.target.closest('.ilmx-ast-faq-q');\n  if(faqBtn){\n    var answer=faqBtn.nextElementSibling;\n    var open=faqBtn.getAttribute('aria-expanded')==='true';\n\n    wrap.querySelectorAll('.ilmx-ast-faq-q').forEach(function(btn){\n      btn.setAttribute('aria-expanded','false');\n      var panel=btn.nextElementSibling;\n      if(panel)panel.hidden=true;\n    });\n\n    if(!open){\n      faqBtn.setAttribute('aria-expanded','true');\n      if(answer)answer.hidden=false;\n    }\n  }\n});\n})();\n</script>\n",
