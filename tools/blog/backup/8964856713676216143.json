m 0.2s; border:none; cursor:pointer;}\n.ilmx-btn-small:hover {transform:scale(1.05); background:#1d7a3a;}\n.ilmx-doa-widget {all:initial; display:block; max-width:100%; margin:20px auto; font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background:linear-gradient(145deg, #0c3808 0%, #061c04 100%); border:1px solid #249749; border-top:5px solid #ffd700; border-radius:20px; padding:24px 20px; box-shadow:0 10px 30px rgba(12, 56, 8, 0.4), inset 0 0 40px rgba(36, 151, 73, 0.1); box-sizing:border-box; position:relative; overflow:hidden;}\n.ilmx-doa-widget::before {content:''; position:absolute; top:0; left:0; right:0; bottom:0; background-image:radial-gradient(#249749 1px, transparent 1px); background-size:20px 20px; opacity:0.1; pointer-events:none;}\n.ilmx-doa-header {text-align:center; position:relative; z-index:2; margin-bottom:24px;}\n.ilmx-doa-icon {font-size:32px; margin-bottom:8px; text-shadow:0 0 15px rgba(255, 215, 0, 0.5);}\n.ilmx-doa-title {color:#ffffff; font-size:22px; font-weight:800; margin:0 0 4px 0; letter-spacing:0.5px; text-transform:uppercase;}\n.ilmx-doa-subtitle {color:#fff!important; font-size:13px; margin:0; font-weight:500;}\n.ilmx-doa-radio {display:none;}\n.ilmx-doa-tab-nav {display:flex; justify-content:center; gap:12px; margin-bottom:24px; position:relative; z-index:2;}\n.ilmx-doa-tab-btn {background:rgba(36, 151, 73, 0.2); color:#a8d5b2; padding:10px 24px; border-radius:30px; font-size:14px; font-weight:600; cursor:pointer; transition:all 0.3s ease; border:1px solid rgba(36, 151, 73, 0.5); user-select:none;}\n.ilmx-doa-tab-btn:hover {background:rgba(36, 151, 73, 0.4); color:#ffffff;}\n#ilmx-doa-tab-sendiri:checked ~ .ilmx-doa-tab-nav label[for=\"ilmx-doa-tab-sendiri\"], #ilmx-doa-tab-ramai:checked ~ .ilmx-doa-tab-nav label[for=\"ilmx-doa-tab-ramai\"] {background:#249749; color:#ffffff; border-color:#ffd700; box-shadow:0 4px 15px rgba(36, 151, 73, 0.6);}\n.ilmx-doa-panels {position:relative; z-index:2;}\n.ilmx-do